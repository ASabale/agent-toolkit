#!/usr/bin/env python3
# @tk-name: code.todos
# @tk-summary: List TODO, FIXME, and similar tags in source comments
# @tk-safety: read-only
# @tk-arg: --path | required | string | File or directory path to scan
# @tk-arg: --tags | optional | string | Comma-separated tags to match (default: TODO,FIXME,HACK,XXX,BUG)
# @tk-arg: --limit | optional | int | Maximum items to return (default: 30)
# @tk-output: json | {path, count, truncated, items:[{file, line, tag, text}]}
# @tk-example: tk run code.todos --path . --tags TODO,FIXME --limit 20
# @tk-verified: 2026-11-04

import io
import json
import os
import re
import sys
import tokenize

_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", ".code-review-graph"}
_DEFAULT_LIMIT = 30
_DEFAULT_TAGS = "TODO,FIXME,HACK,XXX,BUG"
_MARKERS = ("#", "//", "/*", "--")


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def _parse_tags(raw: str) -> list[str]:
    tags = []
    for part in raw.split(","):
        tag = part.strip().upper()
        if tag and tag not in tags:
            tags.append(tag)
    return tags


def _iter_files(root: str):
    if os.path.isfile(root):
        yield root
        return
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = sorted(name for name in dirnames if name not in _SKIP_DIRS)
        for name in sorted(filenames):
            yield os.path.join(dirpath, name)


def _rel(root: str, path: str) -> str:
    if os.path.isfile(root):
        return os.path.basename(path)
    return os.path.relpath(path, root).replace(os.sep, "/")


def _comment_region(line: str) -> str | None:
    indexes = [line.find(marker) for marker in _MARKERS]
    hits = [index for index in indexes if index >= 0]
    if not hits:
        return None
    return line[min(hits):]


def _other_comment_region(line: str) -> str | None:
    indexes = [line.find(marker) for marker in ("//", "/*", "--")]
    hits = [index for index in indexes if index >= 0]
    if not hits:
        return None
    return line[min(hits):]


def _is_python(path: str, text: str) -> bool:
    if path.endswith(".py"):
        return True
    lines = text.splitlines()
    if not lines:
        return False
    first = lines[0]
    return first.startswith("#!") and "python" in first.lower()


def _python_comment_index(text: str):
    comments: dict[int, list[str]] = {}
    string_lines: set[int] = set()
    try:
        for tok in tokenize.generate_tokens(io.StringIO(text).readline):
            if tok.type == tokenize.COMMENT:
                comments.setdefault(tok.start[0], []).append(tok.string)
            elif tok.type == tokenize.STRING:
                for lineno in range(tok.start[0], tok.end[0] + 1):
                    string_lines.add(lineno)
    except (tokenize.TokenError, IndentationError, SyntaxError):
        return None
    return comments, string_lines


def _tag_pattern(tags: list[str]) -> re.Pattern[str]:
    return re.compile(
        r"\b("
        + "|".join(re.escape(tag) for tag in tags)
        + r")(?:\([^)]*\))?\s*:\s*(\S.*)"
    )


def _append_match(items: list[dict], rel: str, lineno: int, region: str, pattern: re.Pattern[str]) -> None:
    if region.strip().startswith("# @tk-"):
        return
    match = pattern.search(region)
    if not match:
        return
    message = match.group(2).strip()
    if not message:
        return
    items.append(
        {
            "file": rel,
            "line": lineno,
            "tag": match.group(1),
            "text": message,
        }
    )


def _scan_text(path: str, text: str, rel: str, pattern: re.Pattern[str], items: list[dict]) -> None:
    parsed = _python_comment_index(text) if _is_python(path, text) else None
    if parsed is None:
        for lineno, line in enumerate(text.splitlines(), start=1):
            region = _comment_region(line)
            if region is not None:
                _append_match(items, rel, lineno, region, pattern)
        return
    comments, string_lines = parsed
    for lineno, line in enumerate(text.splitlines(), start=1):
        if lineno in comments:
            for region in comments[lineno]:
                _append_match(items, rel, lineno, region, pattern)
            continue
        if lineno in string_lines:
            continue
        region = _other_comment_region(line)
        if region is not None:
            _append_match(items, rel, lineno, region, pattern)


def scan(root: str, tags: list[str], limit: int) -> dict:
    if not tags:
        items: list[dict] = []
    else:
        pattern = _tag_pattern(tags)
        items = []
        for path in _iter_files(root):
            try:
                raw = open(path, "rb").read()
            except OSError:
                continue
            if b"\x00" in raw:
                continue
            try:
                text = raw.decode("utf-8")
            except UnicodeDecodeError:
                continue
            _scan_text(path, text, _rel(root, path), pattern, items)
    kept = items[:limit]
    return {
        "path": root,
        "count": len(items),
        "truncated": len(items) > limit,
        "items": kept,
    }


def _limit(raw: str) -> int | None:
    try:
        return int(raw)
    except ValueError:
        return None


def main() -> int:
    path = os.environ.get("TK_ARG_PATH", "")
    tags_raw = os.environ.get("TK_ARG_TAGS") or _DEFAULT_TAGS
    limit_raw = os.environ.get("TK_ARG_LIMIT") or str(_DEFAULT_LIMIT)
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        limit = _limit(limit_raw)
        return emit(
            {
                "dry_run": True,
                "path": path,
                "tags": tags_raw,
                "limit": _DEFAULT_LIMIT if limit is None else limit,
            }
        )
    if not path:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_PATH is required",
                "fix": "tk run code.todos --path <path>",
            },
            2,
        )
    limit = _limit(limit_raw)
    if limit is None or limit < 0:
        return emit(
            {
                "error": "invalid_flag",
                "why": f"limit is not a non-negative int: {limit_raw}",
                "fix": "tk run code.todos --path <path> --limit 30",
            },
            2,
        )
    if not os.path.exists(path):
        return emit(
            {
                "error": "not_found",
                "why": "path does not exist",
                "fix": "tk run code.todos --path <path>",
            },
            2,
        )
    return emit(scan(path, _parse_tags(tags_raw), limit))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        sys.exit(
            emit(
                {"error": "internal_error", "why": str(exc), "fix": "tk check"},
                1,
            )
        )
