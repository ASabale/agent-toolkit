#!/usr/bin/env python3
# @tk-name: code.search
# @tk-summary: Search UTF-8 sources for a regex; default --limit 30 and trimmed lines
# @tk-safety: read-only
# @tk-arg: --path | required | string | File or directory path to search
# @tk-arg: --pattern | required | string | Regular expression pattern to match
# @tk-arg: --glob | optional | string | Optional filename glob filter like *.py (default: all)
# @tk-arg: --limit | optional | int | Maximum matches; explicit values above 30 are honored (default: 30)
# @tk-output: json | {path, pattern, count, truncated, matches:[{file, line, text}]}
# @tk-example: tk run code.search --path lib --pattern def --glob *.py --limit 30
# @tk-verified: 2026-11-04

import fnmatch
import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import arg_int, arg_str, dry_run_ok, emit, fail, is_dry_run

_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", ".code-review-graph"}
_DEFAULT_LIMIT = 30
_TEXT_CAP = 160
_MAX_DEFAULT_BYTES = 2048
_FIX = "tk run code.search --path <path> --pattern <regex>"
_FIX_LIMIT = "tk run code.search --path <path> --pattern <regex> --limit 30"


def _iter_files(root: str):
    if os.path.isfile(root):
        yield root
        return
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = sorted(
            name for name in dirnames if name not in _SKIP_DIRS and not name.startswith(".")
        )
        for name in sorted(filenames):
            if name.startswith(".") or name in _SKIP_DIRS:
                continue
            yield os.path.join(dirpath, name)


def _rel(root: str, path: str) -> str:
    if os.path.isfile(root):
        return os.path.basename(path)
    return os.path.relpath(path, root).replace(os.sep, "/")


def _glob_ok(name: str, pattern: str) -> bool:
    if pattern in {"", "all", "*"}:
        return True
    return fnmatch.fnmatch(name, pattern)


def _encoded_size(payload: dict) -> int:
    return len(json.dumps(payload, separators=(",", ":")).encode("utf-8"))


def _cap_default_payload(payload: dict) -> dict:
    if _encoded_size(payload) <= _MAX_DEFAULT_BYTES:
        return payload
    matches = list(payload["matches"])
    omitted = int(payload["truncated"])
    while matches:
        matches = matches[:-1]
        omitted += 1
        candidate = {
            "path": payload["path"],
            "pattern": payload["pattern"],
            "count": len(matches),
            "truncated": omitted,
            "matches": matches,
        }
        if _encoded_size(candidate) <= _MAX_DEFAULT_BYTES:
            return candidate
    return {
        "path": payload["path"],
        "pattern": payload["pattern"],
        "count": 0,
        "truncated": omitted,
        "matches": [],
    }


def search(root: str, pattern: str, glob: str, limit: int) -> dict:
    compiled = re.compile(pattern)
    matches: list[dict] = []
    for path in _iter_files(root):
        name = os.path.basename(path)
        if not _glob_ok(name, glob):
            continue
        try:
            raw = open(path, "rb").read()
        except OSError:
            continue
        if b"\x00" in raw:
            continue
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue
        rel = _rel(root, path)
        for lineno, line in enumerate(text.splitlines(), start=1):
            if compiled.search(line):
                matches.append({"file": rel, "line": lineno, "text": line[:_TEXT_CAP]})
    omitted = max(0, len(matches) - limit)
    kept = matches[:limit]
    return {
        "path": root,
        "pattern": pattern,
        "count": len(kept),
        "truncated": omitted,
        "matches": kept,
    }


def main() -> int:
    path = arg_str("PATH")
    pattern = arg_str("PATTERN")
    glob = arg_str("GLOB", "all")
    limit_raw = os.environ.get("TK_ARG_LIMIT") or str(_DEFAULT_LIMIT)
    if is_dry_run():
        try:
            limit = int(limit_raw)
        except ValueError:
            limit = _DEFAULT_LIMIT
        return dry_run_ok(path=path, pattern=pattern, glob=glob, limit=limit)
    if not path:
        return fail("missing_flag", "TK_ARG_PATH is required", _FIX, 2)
    if not pattern:
        return fail("missing_flag", "TK_ARG_PATTERN is required", _FIX, 2)
    limit = arg_int("LIMIT", _DEFAULT_LIMIT, min_val=0, fix=_FIX_LIMIT)
    try:
        re.compile(pattern)
    except re.error as exc:
        return fail("invalid_regex", str(exc), _FIX, 2)
    if not os.path.exists(path):
        return fail("not_found", f"{path} does not exist", _FIX, 1)
    payload = search(path, pattern, glob, limit)
    # The 2 KB cap applies to the default limit of 30. An explicit --limit
    # above 30 is honored in full and is not clamped to 30.
    if limit == _DEFAULT_LIMIT:
        payload = _cap_default_payload(payload)
    return emit(payload)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
