#!/usr/bin/env python3
# @tk-name: fs.tree-digest
# @tk-summary: Depth-limited file tree counts, top extensions, and entries
# @tk-safety: read-only
# @tk-arg: --path      | required | string | Directory to summarize
# @tk-arg: --max-depth | optional | int    | How many levels below path to include (default: 2)
# @tk-arg: --limit | optional | int | Max entries to list (default: 40)
# @tk-output: json | {path, files, dirs, top_extensions, entries, truncated}
# @tk-example: tk run fs.tree-digest --path . --max-depth 2 --limit 40
# @tk-verified: 2026-11-03

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import arg_int, arg_str, dry_run_ok, emit, fail, is_dry_run

_SKIP = {
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    ".code-review-graph",
    ".DS_Store",
    ".gitkeep",
}
_TOP_N = 8
_DEFAULT_LIMIT = 40
_FIX = "tk run fs.tree-digest --path <dir>"
_FIX_DEPTH = "tk run fs.tree-digest --path <dir> --max-depth 2"
_FIX_LIMIT = "tk run fs.tree-digest --path <dir> --limit 40"


def digest(root: str, max_depth: int, limit: int) -> dict:
    files = 0
    dirs = 0
    ext_counts: dict[str, int] = {}
    entries: list[dict] = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        rel = os.path.relpath(dirpath, root)
        depth = 0 if rel == "." else rel.count(os.sep) + 1
        if depth > max_depth:
            dirnames[:] = []
            continue
        dirnames[:] = sorted(name for name in dirnames if name not in _SKIP)
        if depth >= max_depth:
            dirnames[:] = []
        if rel != ".":
            dirs += 1
            entries.append({"path": rel.replace(os.sep, "/"), "kind": "dir"})
        for name in sorted(filenames):
            if name in _SKIP:
                continue
            files += 1
            rel_file = name if rel == "." else os.path.join(rel, name)
            entries.append(
                {"path": rel_file.replace(os.sep, "/"), "kind": "file"}
            )
            suffix = os.path.splitext(name)[1].lower()
            if suffix:
                ext_counts[suffix] = ext_counts.get(suffix, 0) + 1
    top = sorted(ext_counts.items(), key=lambda item: (-item[1], item[0]))[:_TOP_N]
    entries.sort(key=lambda item: item["path"])
    omitted = max(0, len(entries) - limit)
    return {
        "path": root,
        "files": files,
        "dirs": dirs,
        "top_extensions": [{"ext": ext, "count": count} for ext, count in top],
        "entries": entries[:limit],
        "truncated": omitted,
    }


def main() -> int:
    path = arg_str("PATH")
    if is_dry_run():
        return dry_run_ok(
            path=path or "example",
            files=0,
            dirs=0,
            top_extensions=[],
            entries=[],
            truncated=0,
        )
    if not path:
        return fail("missing_flag", "TK_ARG_PATH is required", _FIX, 2)
    max_depth = arg_int("MAX_DEPTH", 2, min_val=0, fix=_FIX_DEPTH)
    limit = arg_int("LIMIT", _DEFAULT_LIMIT, min_val=0, fix=_FIX_LIMIT)
    if not os.path.isdir(path):
        return fail("not_a_directory", f"{path} is not a directory", _FIX, 1)
    return emit(digest(path, max_depth, limit))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
