#!/usr/bin/env python3
# @tk-name: json.pick
# @tk-summary: Keep only named top-level keys from a JSON object or array of objects on stdin
# @tk-safety: read-only
# @tk-arg: --keys | required | string | Comma-separated keys to keep
# @tk-output: json | Object or array reduced to the requested keys
# @tk-example: tk run json.pick --keys branch,ahead,dirty
# @tk-verified: 2026-11-03

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import dry_run_ok, emit, fail, is_dry_run

_FIX = "tk run json.pick --keys <k1,k2>"


def keys_from_env() -> list[str]:
    raw = os.environ.get("TK_ARG_KEYS", "")
    return [part.strip() for part in raw.split(",") if part.strip()]


def pick(obj, keys: list[str]):
    if not isinstance(obj, dict):
        return {}
    return {key: obj[key] for key in keys if key in obj}


def main() -> int:
    keys = keys_from_env()
    if is_dry_run():
        return dry_run_ok(keys=keys or ["example"])
    if not keys:
        return fail("missing_flag", "TK_ARG_KEYS is required", _FIX, 2)
    raw = sys.stdin.read()
    if not raw.strip():
        return fail(
            "empty_stdin",
            "json.pick expects a JSON object or array on stdin",
            "tk run <producer> | tk run json.pick --keys <k1,k2>",
        )
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        return fail("invalid_json", str(exc), _FIX)
    if isinstance(data, list):
        return emit([pick(item, keys) for item in data])
    if isinstance(data, dict):
        return emit(pick(data, keys))
    return fail("invalid_json", "stdin JSON must be an object or array", _FIX)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
