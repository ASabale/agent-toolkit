#!/usr/bin/env python3
# @tk-name: json.diff
# @tk-summary: Structural diff of two JSON files by dotted path
# @tk-safety: read-only
# @tk-arg: --left | required | string | Path to left JSON file
# @tk-arg: --right | required | string | Path to right JSON file
# @tk-arg: --limit | optional | int | Maximum diff entries per category (default: 30)
# @tk-output: json | {equal, count, truncated, added:[{path, value}], removed:[{path, value}], changed:[{path, left, right}]}
# @tk-example: tk run json.diff --left a.json --right b.json --limit 20
# @tk-verified: 2026-11-04

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import dry_run_ok, emit, fail, is_dry_run

_FIX = "tk run json.diff --left <a.json> --right <b.json> --limit 30"


def _same_container(left, right) -> bool:
    """True when both values are the same JSON kind.

    Bool is not a number: ``True`` and ``1`` are different kinds even though
    Python treats them as equal. Two non-container scalars share a kind.
    """
    if isinstance(left, bool) or isinstance(right, bool):
        return isinstance(left, bool) and isinstance(right, bool)
    left_container = isinstance(left, (dict, list))
    right_container = isinstance(right, (dict, list))
    if left_container or right_container:
        return (isinstance(left, dict) and isinstance(right, dict)) or (
            isinstance(left, list) and isinstance(right, list)
        )
    return True


def _child(path: str, key: str) -> str:
    return f"{path}.{key}" if path else key


def _index(path: str, index: int) -> str:
    return f"{path}[{index}]"


def _walk(left, right, path: str, added: list, removed: list, changed: list) -> None:
    if isinstance(left, dict) and isinstance(right, dict):
        for key in sorted(set(left) | set(right), key=str):
            child = _child(path, str(key))
            if key not in left:
                added.append({"path": child, "value": right[key]})
            elif key not in right:
                removed.append({"path": child, "value": left[key]})
            else:
                _walk(left[key], right[key], child, added, removed, changed)
        return
    if isinstance(left, list) and isinstance(right, list):
        for index in range(max(len(left), len(right))):
            child = _index(path, index)
            if index >= len(left):
                added.append({"path": child, "value": right[index]})
            elif index >= len(right):
                removed.append({"path": child, "value": left[index]})
            else:
                _walk(left[index], right[index], child, added, removed, changed)
        return
    if not _same_container(left, right):
        # Do not consult ``!=`` here: True != 1 is False in Python.
        changed.append({"path": path or "$", "left": left, "right": right})
        return
    if left != right:
        changed.append({"path": path or "$", "left": left, "right": right})


def diff_docs(left, right) -> tuple[list, list, list]:
    added: list = []
    removed: list = []
    changed: list = []
    _walk(left, right, "", added, removed, changed)
    return added, removed, changed


def main() -> int:
    left_path = os.environ.get("TK_ARG_LEFT", "")
    right_path = os.environ.get("TK_ARG_RIGHT", "")
    limit_raw = os.environ.get("TK_ARG_LIMIT") or "30"
    if is_dry_run():
        try:
            limit = int(limit_raw)
        except ValueError:
            limit = 30
        return dry_run_ok(
            left=left_path or "example",
            right=right_path or "example",
            limit=limit,
        )
    if not left_path or not right_path:
        return fail("missing_flag", "TK_ARG_LEFT and TK_ARG_RIGHT are required", _FIX, 2)
    try:
        limit = int(limit_raw)
    except ValueError:
        return fail("invalid_flag", f"limit is not an int: {limit_raw}", _FIX, 2)
    if limit < 1:
        return fail("invalid_flag", "limit must be >= 1", _FIX, 2)
    try:
        with open(left_path, encoding="utf-8") as handle:
            left = json.load(handle)
        with open(right_path, encoding="utf-8") as handle:
            right = json.load(handle)
    except FileNotFoundError as exc:
        return fail("not_found", f"{exc.filename} not found", _FIX, 2)
    except json.JSONDecodeError as exc:
        return fail("invalid_json", str(exc), _FIX, 2)
    added, removed, changed = diff_docs(left, right)
    total = len(added) + len(removed) + len(changed)
    kept_added = added[:limit]
    kept_removed = removed[:limit]
    kept_changed = changed[:limit]
    truncated = max(0, total - (len(kept_added) + len(kept_removed) + len(kept_changed)))
    return emit(
        {
            "equal": total == 0,
            "count": total,
            "truncated": truncated,
            "added": kept_added,
            "removed": kept_removed,
            "changed": kept_changed,
        }
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
