#!/usr/bin/env python3
# @tk-name: docker.ps-digest
# @tk-summary: Container id, name, image, state, and ports from docker ps
# @tk-safety: read-only
# @tk-arg: --state | optional | string | Filter by running, exited, or all (default: all)
# @tk-arg: --limit | optional | int | Maximum containers to return (default: 25)
# @tk-output: json | {count, running, exited, truncated, containers:[{id, name, image, state, status, ports}]}
# @tk-example: tk run docker.ps-digest --state all --limit 20
# @tk-verified: 2026-11-04

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import arg_int, dry_run_ok, emit, fail, is_dry_run

_FIX = "tk run docker.ps-digest --state all --limit 25"
_STATES = ("all", "running", "exited")


def _field(row: dict, *keys: str) -> str:
    for key in keys:
        if key in row and row[key] is not None:
            return str(row[key])
    return ""


def parse_ps(text: str) -> list[dict]:
    containers: list[dict] = []
    for line in text.splitlines():
        raw = line.strip()
        if not raw:
            continue
        row = json.loads(raw)
        if not isinstance(row, dict):
            raise ValueError("docker ps line is not an object")
        containers.append(
            {
                "id": _field(row, "ID", "Id", "id"),
                "name": _field(row, "Names", "Name", "name"),
                "image": _field(row, "Image", "image"),
                "state": _field(row, "State", "state"),
                "status": _field(row, "Status", "status"),
                "ports": _field(row, "Ports", "ports"),
            }
        )
    return containers


def main() -> int:
    state = (os.environ.get("TK_ARG_STATE") or "all").strip().lower()
    limit_raw = os.environ.get("TK_ARG_LIMIT") or "25"
    if is_dry_run():
        try:
            limit = int(limit_raw)
        except ValueError:
            limit = 25
        if state not in _STATES:
            state = "all"
        return dry_run_ok(state=state, limit=limit)
    if state not in _STATES:
        return fail("invalid_flag", f"state must be all, running, or exited: {state}", _FIX, 2)
    limit = arg_int("LIMIT", 25, fix=_FIX)
    proc = subprocess.run(
        ["docker", "ps", "-a", "--format", "{{json .}}"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    if proc.returncode != 0:
        why = (proc.stderr or proc.stdout or f"docker exited {proc.returncode}").strip()
        return fail("docker_failed", why[:500], "start the docker daemon and retry")
    try:
        parsed = parse_ps(proc.stdout)
    except (json.JSONDecodeError, ValueError) as exc:
        return fail("docker_failed", f"unreadable docker ps output: {exc}", _FIX)
    running = sum(1 for row in parsed if row["state"].lower() == "running")
    exited = sum(1 for row in parsed if row["state"].lower() == "exited")
    if state == "all":
        matched = parsed
    else:
        matched = [row for row in parsed if row["state"].lower() == state]
    shown = matched[:limit]
    return emit(
        {
            "count": len(shown),
            "running": running,
            "exited": exited,
            "truncated": len(matched) > limit,
            "containers": shown,
        }
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        raise SystemExit(fail("docker_failed", "docker timed out after 15s", _FIX))
    except FileNotFoundError as exc:
        name = exc.filename or "docker"
        raise SystemExit(fail("docker_unavailable", f"{name} not found", "install docker and ensure it is on PATH"))
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
