#!/usr/bin/env python3
# @tk-name: sys.port-owner
# @tk-summary: Processes listening on a TCP port (pid, command, user)
# @tk-safety: read-only
# @tk-arg: --port | required | int | TCP port number
# @tk-output: json | {port, listen:[{pid, cmd, user}]}
# @tk-example: tk run sys.port-owner --port 80
# @tk-verified: 2026-11-03

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import dry_run_ok, emit, fail, is_dry_run

_FIX = "tk run sys.port-owner --port <port>"
_FIX_PORT = "tk run sys.port-owner --port 80"


def parse_lsof(text: str) -> list[dict]:
    records: list[dict] = []
    current: dict = {}
    for line in text.splitlines():
        if not line:
            continue
        key, value = line[0], line[1:]
        if key == "p":
            if current.get("pid") is not None:
                records.append(current)
            current = {"pid": int(value), "cmd": "", "user": ""}
        elif key == "c" and current:
            current["cmd"] = value
        elif key == "u" and current:
            current["user"] = value
    if current.get("pid") is not None:
        records.append(current)
    return records[:20]


def main() -> int:
    raw = os.environ.get("TK_ARG_PORT", "")
    if is_dry_run():
        port = int(raw) if raw.isdigit() else 1
        return dry_run_ok(port=port, listen=[])
    if not raw:
        return fail("missing_flag", "TK_ARG_PORT is required", _FIX, 2)
    try:
        port = int(raw)
    except ValueError:
        return fail("invalid_flag", f"port is not an int: {raw}", _FIX_PORT, 2)
    if port < 1 or port > 65535:
        return fail("invalid_flag", "port must be 1-65535", _FIX_PORT, 2)
    proc = subprocess.run(
        ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-F", "pcu"],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if proc.returncode not in (0, 1):
        return fail(
            "lsof_failed",
            proc.stderr.strip() or f"lsof exited {proc.returncode}",
            _FIX,
        )
    return emit({"port": port, "listen": parse_lsof(proc.stdout)})


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        raise SystemExit(fail("timeout", "lsof timed out after 30s", _FIX))
    except FileNotFoundError as exc:
        raise SystemExit(fail("not_found", f"{exc.filename or 'lsof'} not found", _FIX))
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
