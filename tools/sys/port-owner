#!/usr/bin/env python3
# @tk-name: sys.port-owner
# @tk-summary: Processes listening on a TCP port (pid, command, user)
# @tk-safety: read-only
# @tk-arg: --port | required | int | TCP port number
# @tk-output: json | {port, listen:[{pid, cmd, user}]}
# @tk-example: tk run sys.port-owner --port 80
# @tk-verified: 2026-11-03

import json
import os
import subprocess
import sys


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def parse_lsof(text: str) -> list[dict]:
    records: list[dict] = []
    current: dict = {}
    for line in text.splitlines():
        if not line:
            continue
        key, value = line[0], line[1:]
        if key == "p":
            if current.get("pid") is not None:
                records.append(current)
            current = {"pid": int(value), "cmd": "", "user": ""}
        elif key == "c" and current:
            current["cmd"] = value
        elif key == "u" and current:
            current["user"] = value
    if current.get("pid") is not None:
        records.append(current)
    return records[:20]


def main() -> int:
    raw = os.environ.get("TK_ARG_PORT", "")
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        port = int(raw) if raw.isdigit() else 1
        return emit({"dry_run": True, "port": port, "listen": []})
    if not raw:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_PORT is required",
                "fix": "tk run sys.port-owner --port <port>",
            },
            2,
        )
    try:
        port = int(raw)
    except ValueError:
        return emit(
            {
                "error": "invalid_flag",
                "why": f"port is not an int: {raw}",
                "fix": "tk run sys.port-owner --port 80",
            },
            2,
        )
    if port < 1 or port > 65535:
        return emit(
            {
                "error": "invalid_flag",
                "why": "port must be 1-65535",
                "fix": "tk run sys.port-owner --port 80",
            },
            2,
        )
    proc = subprocess.run(
        ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-F", "pcu"],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if proc.returncode not in (0, 1):
        return emit(
            {
                "error": "lsof_failed",
                "why": proc.stderr.strip() or f"lsof exited {proc.returncode}",
                "fix": "tk run sys.port-owner --port <port>",
            },
            1,
        )
    return emit({"port": port, "listen": parse_lsof(proc.stdout)})


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "timeout",
                    "why": "lsof timed out after 30s",
                    "fix": "tk run sys.port-owner --port <port>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
    except FileNotFoundError as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "not_found",
                    "why": f"{exc.filename or 'lsof'} not found",
                    "fix": "tk run sys.port-owner --port <port>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
    except Exception as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "tool_error",
                    "why": str(exc),
                    "fix": "tk run sys.port-owner --port <port>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
