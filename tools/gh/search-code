#!/usr/bin/env python3
# @tk-name: gh.search-code
# @tk-summary: Compact GitHub code search hits for a query, optionally scoped to one repo
# @tk-safety: read-only
# @tk-arg: --query | required | string | Code search query
# @tk-arg: --repo | optional | string | Limit search to owner/name (default: all)
# @tk-arg: --limit | optional | int | Max matches to return (default: 5)
# @tk-output: json | {query, repo, count, matches:[{repo, path, snippet}]}
# @tk-example: tk run gh.search-code --query "def main" --repo cli/cli --limit 5
# @tk-verified: 2026-11-03

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import dry_run_ok, emit, fail, is_dry_run

_SNIPPET_CAP = 180
_FIX = 'tk run gh.search-code --query "def main"'
_FIX_LIMIT = 'tk run gh.search-code --query "def main" --limit 5'
_AUTH_TOKENS = ("auth login", "not logged", "not authenticated", "http 401", "bad credentials")


def gh_fix(why: str, default: str) -> str:
    folded = why.lower()
    if any(token in folded for token in _AUTH_TOKENS):
        return "gh auth login"
    return default


def clip(text: str) -> str:
    text = " ".join((text or "").split())
    if len(text) <= _SNIPPET_CAP:
        return text
    return text[: _SNIPPET_CAP - 1].rstrip() + "…"


def main() -> int:
    query = os.environ.get("TK_ARG_QUERY", "")
    repo = os.environ.get("TK_ARG_REPO") or "all"
    limit_raw = os.environ.get("TK_ARG_LIMIT") or "5"
    if is_dry_run():
        limit = int(limit_raw) if limit_raw.isdigit() else 5
        return dry_run_ok(query=query or "example", repo=repo, limit=limit)
    if not query:
        return fail("missing_flag", "TK_ARG_QUERY is required", _FIX, 2)
    try:
        limit = int(limit_raw)
    except ValueError:
        return fail("invalid_flag", f"limit is not an int: {limit_raw}", _FIX_LIMIT, 2)
    if limit < 0:
        return fail("invalid_flag", "limit must be >= 0", _FIX_LIMIT, 2)
    cmd = [
        "gh",
        "search",
        "code",
        query,
        "--limit",
        str(limit),
        "--json",
        "path,repository,textMatches",
    ]
    if repo and repo != "all":
        cmd.extend(["--repo", repo])
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    if proc.returncode != 0:
        why = (proc.stderr or proc.stdout).strip() or f"gh exited {proc.returncode}"
        return fail("gh_failed", why, gh_fix(why, _FIX))
    rows = json.loads(proc.stdout or "[]")
    matches = []
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        repository = row.get("repository") or {}
        snippet = ""
        for hit in row.get("textMatches") or []:
            if isinstance(hit, dict) and hit.get("fragment"):
                snippet = clip(str(hit["fragment"]))
                break
        matches.append(
            {
                "repo": repository.get("nameWithOwner") or repository.get("name") or "",
                "path": row.get("path") or "",
                "snippet": snippet,
            }
        )
    return emit(
        {
            "query": query,
            "repo": repo,
            "count": len(matches),
            "matches": matches,
        }
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        raise SystemExit(fail("timeout", "gh timed out after 30s", _FIX))
    except FileNotFoundError as exc:
        raise SystemExit(fail("not_found", f"{exc.filename or 'gh'} not found", _FIX))
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
