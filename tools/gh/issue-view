#!/usr/bin/env python3
# @tk-name: gh.issue-view
# @tk-summary: Issue or pull request metadata plus the last N comments
# @tk-safety: read-only
# @tk-arg: --repo | required | string | Repository in owner/name form
# @tk-arg: --number | required | int | Issue or pull request number
# @tk-arg: --comments | optional | int | How many trailing comments to keep (default: 5)
# @tk-output: json | {repo, number, title, state, author, url, body, comments:[{author, body, created_at}]}
# @tk-example: tk run gh.issue-view --repo cli/cli --number 1 --comments 5
# @tk-verified: 2026-11-03

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import dry_run_ok, emit, fail, is_dry_run

_BODY_CAP = 500
_COMMENT_CAP = 280
_FIX = "tk run gh.issue-view --repo <owner/name> --number <n>"
_FIX_INT = "tk run gh.issue-view --repo <owner/name> --number 1 --comments 5"


def clip(text: str, cap: int) -> str:
    text = " ".join((text or "").split())
    if len(text) <= cap:
        return text
    return text[: cap - 1].rstrip() + "…"


def main() -> int:
    repo = os.environ.get("TK_ARG_REPO", "")
    number_raw = os.environ.get("TK_ARG_NUMBER", "")
    comments_raw = os.environ.get("TK_ARG_COMMENTS") or "5"
    if is_dry_run():
        number = int(number_raw) if number_raw.isdigit() else 1
        comments = int(comments_raw) if comments_raw.isdigit() else 5
        return dry_run_ok(repo=repo or "example", number=number, comments=comments)
    if not repo or not number_raw:
        return fail(
            "missing_flag",
            "TK_ARG_REPO and TK_ARG_NUMBER are required",
            _FIX,
            2,
        )
    try:
        number = int(number_raw)
        comments = int(comments_raw)
    except ValueError:
        return fail("invalid_flag", "number and comments must be ints", _FIX_INT, 2)
    if comments < 0:
        return fail("invalid_flag", "comments must be >= 0", _FIX_INT, 2)
    proc = subprocess.run(
        [
            "gh",
            "issue",
            "view",
            str(number),
            "--repo",
            repo,
            "--json",
            "number,title,state,author,url,body,comments",
        ],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if proc.returncode != 0:
        return fail(
            "gh_failed",
            (proc.stderr or proc.stdout).strip() or f"gh exited {proc.returncode}",
            _FIX,
        )
    payload = json.loads(proc.stdout or "{}")
    author = payload.get("author") or {}
    raw_comments = payload.get("comments") or []
    tail = raw_comments[-comments:] if comments else []
    distilled = []
    for comment in tail:
        if not isinstance(comment, dict):
            continue
        who = comment.get("author") or {}
        distilled.append(
            {
                "author": who.get("login") or "",
                "body": clip(str(comment.get("body") or ""), _COMMENT_CAP),
                "created_at": comment.get("createdAt") or "",
            }
        )
    return emit(
        {
            "repo": repo,
            "number": payload.get("number") or number,
            "title": payload.get("title") or "",
            "state": payload.get("state") or "",
            "author": author.get("login") or "",
            "url": payload.get("url") or "",
            "body": clip(str(payload.get("body") or ""), _BODY_CAP),
            "comments": distilled,
        }
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        raise SystemExit(fail("timeout", "gh timed out after 30s", _FIX))
    except FileNotFoundError as exc:
        raise SystemExit(fail("not_found", f"{exc.filename or 'gh'} not found", _FIX))
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX))
