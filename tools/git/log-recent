#!/usr/bin/env python3
# @tk-name: git.log-recent
# @tk-summary: Recent commits in a git working tree (sha, date, author, subject)
# @tk-safety: read-only
# @tk-arg: --repo  | required | string | Path to the git working tree
# @tk-arg: --limit | optional | int    | Maximum commits to return (default: 5)
# @tk-output: json | {dry_run, repo, limit, count, commits:[{sha, date, author, subject}]}
# @tk-example: tk run git.log-recent --repo . --limit 5
# @tk-verified: 2026-11-03

import json
import os
import shlex
import subprocess
import sys


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def git(repo: str, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=30,
    )


def parse_log(text: str) -> list[dict]:
    commits: list[dict] = []
    for line in text.splitlines():
        if not line.strip():
            continue
        sha, date, author, subject = (line.split("\x1f", 3) + ["", "", ""])[:4]
        commits.append(
            {"sha": sha, "date": date, "author": author, "subject": subject}
        )
    return commits


def _limit_fix() -> str:
    """Copy-pasteable command: caller flags, with only --limit corrected."""
    repo = os.environ.get("TK_ARG_REPO", "")
    argv = [
        "tk",
        "run",
        "git.log-recent",
        "--repo",
        repo if repo else ".",
        "--limit",
        "5",
    ]
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        argv.append("--dry-run")
    return shlex.join(argv)


def resolve_limit(limit_raw: str) -> int | dict:
    fix = _limit_fix()
    try:
        limit = int(limit_raw)
    except ValueError:
        return {
            "error": "invalid_flag",
            "why": f"limit is not an int: {limit_raw}",
            "fix": fix,
        }
    if limit < 1:
        return {
            "error": "invalid_flag",
            "why": "limit must be >= 1",
            "fix": fix,
        }
    return limit


def main() -> int:
    repo = os.environ.get("TK_ARG_REPO", "")
    limit_raw = os.environ.get("TK_ARG_LIMIT") or "5"
    resolved = resolve_limit(limit_raw)
    if isinstance(resolved, dict):
        return emit(resolved, 2)
    limit = resolved
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        return emit(
            {
                "dry_run": True,
                "repo": repo or "example",
                "limit": limit,
                "count": None,
                "commits": [],
            }
        )
    if not repo:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_REPO is required",
                "fix": "tk run git.log-recent --repo <path>",
            },
            2,
        )
    probe = git(repo, "rev-parse", "--is-inside-work-tree")
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        return emit(
            {
                "error": "not_a_repo",
                "why": probe.stderr.strip() or f"{repo} is not a git working tree",
                "fix": "tk run git.log-recent --repo <git-dir>",
            },
            1,
        )
    log = git(
        repo,
        "log",
        "-n",
        str(limit),
        "--pretty=format:%H%x1f%aI%x1f%an%x1f%s",
    )
    if log.returncode != 0:
        return emit(
            {
                "error": "git_failed",
                "why": log.stderr.strip() or "git log failed",
                "fix": "tk run git.log-recent --repo <git-dir> --limit 5",
            },
            1,
        )
    commits = parse_log(log.stdout)
    return emit({"repo": repo, "count": len(commits), "commits": commits})


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "timeout",
                    "why": "git timed out after 30s",
                    "fix": "tk run git.log-recent --repo <git-dir>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
    except FileNotFoundError as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "not_found",
                    "why": f"{exc.filename or 'git'} not found",
                    "fix": "tk run git.log-recent --repo <git-dir>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
    except Exception as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "tool_error",
                    "why": str(exc),
                    "fix": "tk run git.log-recent --repo <git-dir>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
