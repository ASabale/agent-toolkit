#!/usr/bin/env python3
# @tk-name: git.branch-digest
# @tk-summary: Branch, upstream drift, and dirty-file count for a git working tree
# @tk-safety: read-only
# @tk-arg: --repo | required | string | Path to the git working tree
# @tk-output: json | {branch, ahead, behind, dirty, detached, upstream}
# @tk-example: tk run git.branch-digest --repo .
# @tk-verified: 2026-11-03

import json
import os
import subprocess
import sys


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def git(repo: str, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=30,
    )


def main() -> int:
    repo = os.environ.get("TK_ARG_REPO", "")
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        return emit(
            {
                "branch": "example",
                "ahead": 0,
                "behind": 0,
                "dirty": 0,
                "detached": False,
                "upstream": None,
            }
        )
    if not repo:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_REPO is required",
                "fix": "tk run git.branch-digest --repo <path>",
            },
            2,
        )
    probe = git(repo, "rev-parse", "--is-inside-work-tree")
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        return emit(
            {
                "error": "not_a_repo",
                "why": probe.stderr.strip() or f"{repo} is not a git working tree",
                "fix": "tk run git.branch-digest --repo <git-dir>",
            },
            1,
        )
    head = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    unborn = head.returncode != 0
    if unborn:
        sym = git(repo, "symbolic-ref", "--short", "HEAD")
        if sym.returncode == 0 and sym.stdout.strip():
            branch = sym.stdout.strip()
            detached = False
        else:
            branch = "HEAD"
            detached = True
    else:
        detached = head.stdout.strip() == "HEAD"
    if not unborn and detached:
        short = git(repo, "rev-parse", "--short", "HEAD")
        branch = short.stdout.strip()
    elif not unborn:
        branch = head.stdout.strip()
    status = git(repo, "status", "--porcelain")
    dirty = len([line for line in status.stdout.splitlines() if line.strip()])
    if unborn:
        return emit(
            {
                "branch": branch,
                "ahead": 0,
                "behind": 0,
                "dirty": dirty,
                "detached": detached,
                "upstream": None,
            }
        )
    upstream_proc = git(repo, "rev-parse", "--abbrev-ref", "@{upstream}")
    if upstream_proc.returncode != 0:
        upstream = None
        ahead = None
        behind = None
    else:
        upstream = upstream_proc.stdout.strip()
        counts = git(repo, "rev-list", "--left-right", "--count", f"HEAD...{upstream}")
        parts = counts.stdout.split()
        ahead = int(parts[0]) if len(parts) == 2 else None
        behind = int(parts[1]) if len(parts) == 2 else None
    return emit(
        {
            "branch": branch,
            "ahead": ahead,
            "behind": behind,
            "dirty": dirty,
            "detached": detached,
            "upstream": upstream,
        }
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "timeout",
                    "why": "git timed out after 30s",
                    "fix": "tk run git.branch-digest --repo <git-dir>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
    except FileNotFoundError as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "not_found",
                    "why": f"{exc.filename or 'git'} not found",
                    "fix": "tk run git.branch-digest --repo <git-dir>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
    except Exception as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "tool_error",
                    "why": str(exc),
                    "fix": "tk run git.branch-digest --repo <git-dir>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
