#!/usr/bin/env python3
# @tk-name: git.branch-digest
# @tk-summary: Branch, upstream drift, and dirty-file count for a git working tree
# @tk-safety: read-only
# @tk-arg: --repo | required | string | Path to the git working tree
# @tk-output: json | {dry_run, repo, branch, ahead, behind, dirty, detached, upstream}
# @tk-example: tk run git.branch-digest --repo .
# @tk-verified: 2026-11-03

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.tool_sdk import arg_str, dry_run_ok, emit, fail, is_dry_run

_FIX = "tk run git.branch-digest --repo <path>"
_FIX_REPO = "tk run git.branch-digest --repo <git-dir>"


def git(repo: str, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=30,
    )


def main() -> int:
    repo = arg_str("REPO")
    if is_dry_run():
        return dry_run_ok(
            repo=repo or "example",
            branch=None,
            ahead=None,
            behind=None,
            dirty=None,
            detached=None,
            upstream=None,
        )
    if not repo:
        return fail("missing_flag", "TK_ARG_REPO is required", _FIX, 2)
    probe = git(repo, "rev-parse", "--is-inside-work-tree")
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        return fail(
            "not_a_repo",
            probe.stderr.strip() or f"{repo} is not a git working tree",
            _FIX_REPO,
            1,
        )
    head = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    unborn = head.returncode != 0
    if unborn:
        sym = git(repo, "symbolic-ref", "--short", "HEAD")
        if sym.returncode == 0 and sym.stdout.strip():
            branch = sym.stdout.strip()
            detached = False
        else:
            branch = "HEAD"
            detached = True
    else:
        detached = head.stdout.strip() == "HEAD"
    if not unborn and detached:
        short = git(repo, "rev-parse", "--short", "HEAD")
        branch = short.stdout.strip()
    elif not unborn:
        branch = head.stdout.strip()
    status = git(repo, "status", "--porcelain")
    dirty = len([line for line in status.stdout.splitlines() if line.strip()])
    if unborn:
        return emit(
            {
                "branch": branch,
                "ahead": 0,
                "behind": 0,
                "dirty": dirty,
                "detached": detached,
                "upstream": None,
            }
        )
    upstream_proc = git(repo, "rev-parse", "--abbrev-ref", "@{upstream}")
    if upstream_proc.returncode != 0:
        upstream = None
        ahead = None
        behind = None
    else:
        upstream = upstream_proc.stdout.strip()
        counts = git(repo, "rev-list", "--left-right", "--count", f"HEAD...{upstream}")
        parts = counts.stdout.split()
        ahead = int(parts[0]) if len(parts) == 2 else None
        behind = int(parts[1]) if len(parts) == 2 else None
    return emit(
        {
            "branch": branch,
            "ahead": ahead,
            "behind": behind,
            "dirty": dirty,
            "detached": detached,
            "upstream": upstream,
        }
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.TimeoutExpired:
        raise SystemExit(fail("timeout", "git timed out after 30s", _FIX_REPO))
    except FileNotFoundError as exc:
        raise SystemExit(fail("not_found", f"{exc.filename or 'git'} not found", _FIX_REPO))
    except Exception as exc:
        raise SystemExit(fail("tool_error", str(exc), _FIX_REPO))
