#!/usr/bin/env python3
# @tk-name: git.sync
# @tk-summary: Rebase the current feature branch onto origin/main and push it
# @tk-safety: mutating
# @tk-arg: --repo | required | string | Path to the git working tree
# @tk-arg: --remote | optional | string | Remote name to sync with (default: origin)
# @tk-arg: --branch | optional | string | Base branch to rebase onto (default: main)
# @tk-output: json | {repo, remote, branch, base, status, ahead, behind, rebased, pushed}
# @tk-example: tk run git.sync --repo .
# @tk-verified: 2026-11-04

import json
import os
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

# Catalog smoke sets the required string flag to this dummy and leaves optionals unset.
_SMOKE_REPO = "example"


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def _git_env() -> dict[str, str]:
    """Ignore inherited GIT_DIR so -C always selects --repo, even inside a hook."""
    env = os.environ.copy()
    for key in list(env):
        if key.startswith("GIT_"):
            env.pop(key, None)
    return env


def git(repo: str, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=30,
        env=_git_env(),
    )


def _git_ok(repo: Path, *args: str) -> None:
    proc = subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
        env=_git_env(),
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "git failed").strip()
        raise RuntimeError(detail)


def counts(repo: str, remote: str, base: str) -> tuple[int, int] | None:
    probe = git(repo, "rev-list", "--left-right", "--count", f"HEAD...{remote}/{base}")
    if probe.returncode != 0:
        return None
    parts = probe.stdout.split()
    if len(parts) != 2:
        return None
    return int(parts[0]), int(parts[1])


def fail(error: str, why: str, fix: str, code: int = 1) -> int:
    return emit({"error": error, "why": why, "fix": fix}, code)


def current_branch(repo: str) -> str:
    head = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    return head.stdout.strip() if head.returncode == 0 else ""


def _supplied(env_name: str) -> str | None:
    if env_name not in os.environ:
        return None
    value = os.environ[env_name]
    return value or None


def sync_command(repo: str) -> str:
    """Rebuild the call with every flag the caller actually set, shell-quoted."""
    parts = ["tk", "run", "git.sync", "--repo", shlex.quote(repo)]
    remote = _supplied("TK_ARG_REMOTE")
    if remote is not None:
        parts.extend(["--remote", shlex.quote(remote)])
    branch = _supplied("TK_ARG_BRANCH")
    if branch is not None:
        parts.extend(["--branch", shlex.quote(branch)])
    return " ".join(parts)


def dry_run_payload(repo: str, remote: str, base: str) -> dict:
    current = current_branch(repo)
    return {
        "dry_run": True,
        "repo": repo,
        "remote": remote,
        "base": base,
        "branch": current,
        "plan": [
            f"git fetch {remote} {base}",
            f"git pull --rebase --autostash {remote} {base}",
            f"git push --force-with-lease --set-upstream {remote} {current}",
        ],
    }


def _is_work_tree(repo: str) -> bool:
    probe = git(repo, "rev-parse", "--is-inside-work-tree")
    return probe.returncode == 0 and probe.stdout.strip() == "true"


def _catalog_smoke(repo: str, dry_run: bool) -> bool:
    """True only for the catalog's dummy invocation, not a real --repo example."""
    if not dry_run or repo != _SMOKE_REPO:
        return False
    if _supplied("TK_ARG_REMOTE") is not None or _supplied("TK_ARG_BRANCH") is not None:
        return False
    return not _is_work_tree(repo)


def _smoke_plan(remote: str, base: str) -> dict:
    """Preview against a throwaway feature branch so smoke still sees a real plan."""
    with tempfile.TemporaryDirectory(prefix="tk-git-sync-") as tmp:
        repo = Path(tmp) / "repo"
        repo.mkdir()
        _git_ok(repo, "init", "-b", "main")
        _git_ok(repo, "config", "user.email", "ada@example.com")
        _git_ok(repo, "config", "user.name", "Ada")
        (repo / "README").write_text("smoke\n", encoding="utf-8")
        _git_ok(repo, "add", "README")
        _git_ok(repo, "commit", "-m", "init")
        _git_ok(repo, "checkout", "-b", "feature")
        return dry_run_payload(str(repo), remote, base)


def _feature_fix(repo: str) -> str:
    return f"git checkout -b fix/sync && {sync_command(repo)}"


def _not_a_repo_fix(repo: str) -> str:
    quoted = shlex.quote(repo)
    init = f"git init -b fix/sync -- {quoted}"
    commit = (
        f"git -C {quoted} -c user.email=ada@example.com -c user.name=Ada "
        "commit --allow-empty -m init"
    )
    return f"{init} && {commit} && {sync_command(repo)}"


def refuse_current_branch(repo: str, current: str, base: str) -> int | None:
    """Refuse detached, main, or the rebase base. None means a feature branch."""
    create = _feature_fix(repo)
    if current == "HEAD" or not current:
        return fail(
            "detached_head",
            "git.sync needs a named feature branch; HEAD is detached",
            create,
            2,
        )
    if current == "main" or current == base:
        error = "on_main" if current == "main" else "on_base"
        return fail(
            error,
            f"git.sync refuses to mutate {current}; every change goes through a feature-branch pull request",
            create,
            2,
        )
    return None


def refuse_not_a_repo(repo: str) -> int:
    return fail(
        "not_a_repo",
        f"{repo} is not a git working tree",
        _not_a_repo_fix(repo),
        2,
    )


def rebase_onto(repo: str, remote: str, base: str) -> tuple[tuple[int, int] | None, str, str]:
    pulled = git(repo, "pull", "--rebase", "--autostash", remote, base)
    if pulled.returncode != 0:
        git(repo, "rebase", "--abort")
        why = (pulled.stderr or pulled.stdout).strip() or "rebase failed"
        return None, "rebase_conflict", why
    pair = counts(repo, remote, base)
    if pair is None:
        return None, "git_failed", "rebase succeeded but ahead/behind could not be recomputed"
    return pair, "", ""


def _sync(repo: str, remote: str, base: str, current: str, retry: str) -> int:
    fetched = git(repo, "fetch", remote, base)
    if fetched.returncode != 0:
        return fail("git_failed", fetched.stderr.strip() or "git fetch failed", retry)
    pair = counts(repo, remote, base)
    if pair is None:
        return fail("git_failed", f"could not compare HEAD with {remote}/{base}", retry)
    ahead, behind = pair
    rebased = False
    if behind != 0:
        pair, error, why = rebase_onto(repo, remote, base)
        if pair is None:
            fix = (
                f"resolve the conflicting commit in {shlex.quote(repo)}, then retry {retry}"
                if error == "rebase_conflict"
                else retry
            )
            return fail(error, why, fix)
        ahead, behind = pair
        rebased = True
    pushed = git(repo, "push", "--force-with-lease", "--set-upstream", remote, current)
    if pushed.returncode != 0:
        return fail(
            "git_failed",
            pushed.stderr.strip() or "git push failed",
            f"git push --force-with-lease --set-upstream {shlex.quote(remote)} {shlex.quote(current)}",
        )
    return emit(
        {
            "repo": repo,
            "remote": remote,
            "branch": current,
            "base": base,
            "status": "rebased" if rebased else "up_to_date",
            "ahead": ahead,
            "behind": behind,
            "rebased": rebased,
            "pushed": True,
        }
    )


def main() -> int:
    repo = os.environ.get("TK_ARG_REPO", "")
    remote = os.environ.get("TK_ARG_REMOTE") or "origin"
    base = os.environ.get("TK_ARG_BRANCH") or "main"
    dry_run = os.environ.get("TK_DRY_RUN", "0") == "1"
    retry = sync_command(repo) if repo else "tk run git.sync --repo <path>"
    if not repo:
        return fail("missing_flag", "TK_ARG_REPO is required", "tk run git.sync --repo <path>", 2)
    try:
        if _catalog_smoke(repo, dry_run):
            return emit(_smoke_plan(remote, base))
        if not _is_work_tree(repo):
            return refuse_not_a_repo(repo)
        current = current_branch(repo)
        blocked = refuse_current_branch(repo, current, base)
        if blocked is not None:
            return blocked
        if dry_run:
            return emit(dry_run_payload(repo, remote, base))
        return _sync(repo, remote, base, current, retry)
    except subprocess.TimeoutExpired:
        git(repo, "rebase", "--abort")
        return fail("git_failed", "git command timed out", retry)
    except Exception as exc:
        return fail("internal_error", str(exc), "tk check git.sync")


if __name__ == "__main__":
    sys.exit(main())
