#!/usr/bin/env python3
# @tk-name: git.sync
# @tk-summary: Fetch and rebase-sync a git working tree with its remote branch safely
# @tk-safety: mutating
# @tk-arg: --repo | required | string | Path to the git working tree
# @tk-arg: --remote | optional | string | Remote name to sync with (default: origin)
# @tk-arg: --branch | optional | string | Branch name to sync (default: main)
# @tk-output: json | {repo, remote, branch, status, ahead, behind, rebased}
# @tk-example: tk run git.sync --repo . --remote origin --branch main
# @tk-verified: 2026-11-04

import json
import os
import subprocess
import sys


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def git(repo: str, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", repo, *args],
        capture_output=True,
        text=True,
        timeout=30,
    )


def counts(repo: str, remote: str, branch: str) -> tuple[int, int] | None:
    probe = git(repo, "rev-list", "--left-right", "--count", f"HEAD...{remote}/{branch}")
    if probe.returncode != 0:
        return None
    parts = probe.stdout.split()
    if len(parts) != 2:
        return None
    return int(parts[0]), int(parts[1])


def main() -> int:
    repo = os.environ.get("TK_ARG_REPO", "")
    remote = os.environ.get("TK_ARG_REMOTE") or "origin"
    branch = os.environ.get("TK_ARG_BRANCH") or "main"
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        return emit({"dry_run": True, "repo": repo, "remote": remote, "branch": branch})
    if not repo:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_REPO is required",
                "fix": "tk run git.sync --repo <path>",
            },
            2,
        )
    try:
        fetched = git(repo, "fetch", remote, branch)
        if fetched.returncode != 0:
            return emit(
                {
                    "error": "git_failed",
                    "why": fetched.stderr.strip() or "git fetch failed",
                    "fix": "tk run git.sync --repo <git-dir> --remote origin --branch main",
                },
                1,
            )
        pair = counts(repo, remote, branch)
        if pair is None:
            return emit(
                {
                    "error": "git_failed",
                    "why": f"could not compare HEAD with {remote}/{branch}",
                    "fix": "tk run git.sync --repo <git-dir> --remote origin --branch main",
                },
                1,
            )
        ahead, behind = pair
        if behind == 0:
            return emit(
                {
                    "repo": repo,
                    "remote": remote,
                    "branch": branch,
                    "status": "up_to_date",
                    "ahead": ahead,
                    "behind": 0,
                    "rebased": False,
                }
            )
        pulled = git(repo, "pull", "--rebase", "--autostash", remote, branch)
        if pulled.returncode != 0:
            git(repo, "rebase", "--abort")
            return emit(
                {
                    "error": "rebase_conflict",
                    "why": (pulled.stderr or pulled.stdout).strip() or "rebase failed",
                    "fix": f"resolve the conflicting commit in {repo}, then retry tk run git.sync --repo {repo}",
                },
                1,
            )
        pair = counts(repo, remote, branch)
        if pair is None:
            return emit(
                {
                    "error": "git_failed",
                    "why": "rebase succeeded but ahead/behind could not be recomputed",
                    "fix": "tk run git.sync --repo <git-dir> --remote origin --branch main",
                },
                1,
            )
        ahead, behind = pair
        return emit(
            {
                "repo": repo,
                "remote": remote,
                "branch": branch,
                "status": "rebased",
                "ahead": ahead,
                "behind": behind,
                "rebased": True,
            }
        )
    except subprocess.TimeoutExpired:
        git(repo, "rebase", "--abort")
        return emit(
            {
                "error": "git_failed",
                "why": "git command timed out",
                "fix": "tk run git.sync --repo <git-dir> --remote origin --branch main",
            },
            1,
        )
    except Exception as exc:
        return emit(
            {
                "error": "internal_error",
                "why": str(exc),
                "fix": "tk check git.sync",
            },
            1,
        )


if __name__ == "__main__":
    sys.exit(main())
