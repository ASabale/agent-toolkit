#!/usr/bin/env python3
# @tk-name: tk.migrate
# @tk-summary: Export or copy tools, chains, and the skill between toolkit checkouts. Secret scan is the redact rules only
# @tk-safety: destructive
# @tk-arg: --action | optional | string | report, export, or apply (default: report)
# @tk-arg: --source | optional | string | Source Agent Toolkit checkout
# @tk-arg: --dest | optional | string | Destination Agent Toolkit checkout
# @tk-arg: --apply | optional | bool | Write files during apply; dry-run is the default
# @tk-arg: --manifest | optional | string | Manifest JSON to apply; a hash mismatch aborts the copy
# @tk-arg: --allow-secret-scan | optional | string | Copy this relative path even when the secret scan hits
# @tk-output: json | object
# @tk-example: tk run tk.migrate --action report
# @tk-verified: none

from __future__ import annotations

import hashlib
import json
import os
import shutil
import stat
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lib.catalog import check_item
from lib.redact import secret_hits
from lib.tool_sdk import arg_str, emit, fail

FIX = "tk run tk.migrate --action report"
_MANIFEST_VERSION = 1
_SKIP_PARTS = {"state", ".git", "__pycache__"}
_SKIP_NAMES = {
    "policy.json",
    "audit.jsonl",
    "trace.jsonl",
    "credentials",
    "credentials.json",
    "approvals.json",
    "approval.json",
    "confirmations.json",
}


def _truthy(raw: str) -> bool:
    return raw.strip().lower() in {"1", "true", "yes", "on"}


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _version_string(root: Path) -> str | None:
    path = root / "VERSION"
    if not path.is_file() or path.is_symlink():
        return None
    text = path.read_text(encoding="utf-8").strip()
    return text or None


def _reject_user_path(label: str, raw: str) -> str | None:
    if not raw.strip():
        return f"{label} is required"
    if raw.startswith("-"):
        return f"{label} must not start with -"
    if ".." in Path(raw).parts:
        return f"{label} must not contain .."
    return None


def _inside(root: Path, path: Path) -> bool:
    try:
        path.resolve().relative_to(root.resolve())
    except (OSError, ValueError):
        return False
    return True


def _skipped(rel: Path) -> bool:
    if any(part in _SKIP_PARTS for part in rel.parts):
        return True
    lowered = rel.name.lower()
    if rel.name in _SKIP_NAMES or lowered.startswith(".env") or lowered.endswith(".env"):
        return True
    return any(word in lowered for word in ("token", "credential", "secret", "approval"))


def _kind(rel: Path) -> str | None:
    parts = rel.parts
    if any(part.startswith(".") or part in _SKIP_PARTS for part in parts):
        return None
    if rel.suffix.lower() in (".pyc", ".pyo"):
        return None
    if parts[0] == "tools":
        return "tool"
    if parts[0] == "chains":
        return "chain" if rel.suffix.lower() == ".json" else None
    if parts[:2] == ("skills", "agent-toolkit"):
        return "skill"
    return None


def _override_paths() -> tuple[set[str], str | None]:
    raw = arg_str("--allow-secret-scan").strip()
    if not raw:
        return set(), None
    if raw.startswith("/") or ".." in Path(raw).parts:
        return set(), "allow-secret-scan path refused"
    return {raw}, None


def _secret_scan() -> dict:
    return {
        "excluded_by_path": [],
        "excluded_by_content": [],
        "unscannable": [],
        "scanned_clean": [],
        "overrides": [],
        "hit_copied": False,
    }


def _classify(rel: str, data: bytes, overrides: set[str], scan: dict) -> bool:
    """Return whether the file may be copied. Never store matched text."""
    try:
        text = data.decode("utf-8")
    except UnicodeError:
        scan["unscannable"].append(rel)
        return False
    hits = secret_hits(text)
    if hits and rel in overrides:
        scan["overrides"].append({"path": rel, "rules": hits})
        return True
    if hits:
        scan["excluded_by_content"].append({"path": rel, "rules": hits})
        return False
    scan["scanned_clean"].append(rel)
    return True


def _scan(source: Path, overrides: set[str] | None = None) -> tuple[list[dict], dict, str | None]:
    roots = [source / "tools", source / "chains", source / "skills" / "agent-toolkit"]
    version = _version_string(source)
    allow = overrides or set()
    scan = _secret_scan()
    files: list[dict] = []
    for base in roots:
        if not base.exists():
            continue
        if base.is_symlink() and not _inside(source, base):
            return [], scan, f"symlink leaves source: {base}"
        for dirpath, dirnames, filenames in os.walk(base, followlinks=False):
            current = Path(dirpath)
            kept = []
            for dirname in dirnames:
                child = current / dirname
                if child.is_symlink() and not _inside(source, child):
                    return [], scan, f"symlink leaves source: {child}"
                kept.append(dirname)
            dirnames[:] = kept
            for name in filenames:
                path = current / name
                rel = path.relative_to(source)
                if path.is_symlink():
                    if not _inside(source, path):
                        return [], scan, f"symlink leaves source: {path}"
                    continue
                if not path.is_file():
                    continue
                if _skipped(rel):
                    scan["excluded_by_path"].append(rel.as_posix())
                    continue
                kind = _kind(rel)
                if kind is None:
                    continue
                data = path.read_bytes()
                rel_text = rel.as_posix()
                if not _classify(rel_text, data, allow, scan):
                    continue
                files.append(
                    {
                        "path": rel_text,
                        "kind": kind,
                        "sha256": _sha256(data),
                        "size": len(data),
                        "executable": bool(path.stat().st_mode & stat.S_IXUSR),
                        "source_version": version,
                    }
                )
    files.sort(key=lambda row: row["path"])
    for key in ("excluded_by_path", "excluded_by_content", "unscannable", "scanned_clean", "overrides"):
        scan[key].sort(key=lambda item: item["path"] if isinstance(item, dict) else item)
    return files, scan, None


def _manifest(source: Path, overrides: set[str] | None = None) -> tuple[dict | None, str | None]:
    files, scan, error = _scan(source, overrides)
    if error:
        return None, error
    return {
        "version": _MANIFEST_VERSION,
        "source_version": _version_string(source),
        "files": files,
        "secret_scan": scan,
    }, None


def _listed_bytes(source: Path, rel: str) -> tuple[bytes | None, bool | None, str | None]:
    """Read one listed source file. Symlinks and paths outside the checkout fail."""
    probe = source
    for part in Path(rel).parts:
        probe = probe / part
        try:
            linked = probe.is_symlink()
        except OSError:
            return None, None, f"manifest path missing: {rel}"
        if linked and not _inside(source, probe):
            return None, None, f"symlink leaves source: {probe}"
        if linked:
            return None, None, f"manifest path refused: {rel}"
    data = _read(probe)
    if data is None:
        return None, None, f"manifest path missing: {rel}"
    try:
        executable = bool(probe.stat().st_mode & stat.S_IXUSR)
    except OSError:
        return None, None, f"manifest path missing: {rel}"
    return data, executable, None


def _checked_files(rows: object, source: Path) -> tuple[list[dict] | None, str | None]:
    """Validate the supplied entries. Never widens them with a tree scan."""
    if not isinstance(rows, list):
        return None, "manifest files must be a list"
    seen: set[str] = set()
    checked: list[dict] = []
    for row in rows:
        if not isinstance(row, dict):
            return None, "manifest entry is not an object"
        rel = row.get("path")
        if not isinstance(rel, str) or not rel or rel.startswith("/") or Path(rel).is_absolute() or ".." in Path(rel).parts:
            return None, f"manifest path refused: {rel}"
        if rel in seen:
            return None, f"manifest duplicate path: {rel}"
        seen.add(rel)
        kind = _kind(Path(rel))
        if kind not in {"tool", "chain", "skill"}:
            return None, f"manifest path refused: {rel}"
        data, executable, error = _listed_bytes(source, rel)
        if error or data is None or executable is None:
            return None, error or f"manifest path missing: {rel}"
        digest = _sha256(data)
        if row.get("sha256") != digest or row.get("size") != len(data):
            return None, f"manifest hash mismatch: {rel}"
        if row.get("kind") != kind or row.get("executable") is not executable:
            return None, f"manifest entry mismatch: {rel}"
        checked.append(
            {
                "path": rel,
                "kind": kind,
                "sha256": digest,
                "size": len(data),
                "executable": executable,
                "source_version": row.get("source_version"),
            }
        )
    return checked, None


def _load_manifest(raw: str, source: Path) -> tuple[dict | None, str | None]:
    """Return the supplied manifest's files after they match the source bytes.

    Apply uses this list as the allowlist. A file present in the tree but absent
    here is not imported. Export still scans; this function does not.
    """
    reason = _reject_user_path("manifest", raw)
    if reason:
        return None, reason
    path = Path(raw)
    if path.is_symlink() or not path.is_file():
        return None, "manifest is not a file"
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return None, f"manifest is not json: {exc}"
    if not isinstance(parsed, dict) or parsed.get("version") != _MANIFEST_VERSION:
        return None, "manifest version must be 1"
    checked, error = _checked_files(parsed.get("files"), source)
    if error or checked is None:
        return None, error
    parsed["files"] = checked
    return parsed, None


def _dest_stays(dest: Path, rel: Path) -> bool:
    probe = dest
    for part in rel.parts:
        probe = probe / part
        if probe.is_symlink() and not _inside(dest, probe):
            return False
        if probe.exists() and not _inside(dest, probe):
            return False
    parent = (dest / rel).parent
    return not parent.exists() or _inside(dest, parent)


def _read(path: Path) -> bytes | None:
    try:
        if path.is_symlink() or not path.is_file():
            return None
        return path.read_bytes()
    except OSError:
        return None


def _tool_name(data: bytes) -> str:
    for raw in data.splitlines():
        line = raw.decode("utf-8", errors="replace")
        if line.startswith("# @tk-name:"):
            return line.split(":", 1)[1].strip()
    return ""


def _destination_pins(source: Path, files: list[dict]) -> dict[str, str]:
    """Hash the tool bytes that apply will write, after header normalization."""
    pins: dict[str, str] = {}
    for row in files:
        if row.get("kind") != "tool":
            continue
        data = _read(source / str(row.get("path") or ""))
        if data is None:
            continue
        drafted = _draft_bytes(data)
        name = _tool_name(drafted)
        if name:
            pins[name] = _sha256(drafted)
    return pins


def _rewrite_chain(data: bytes, pins: dict[str, str], rel: str) -> tuple[bytes | None, str | None]:
    """Point pinned steps at the imported tool bytes. An absent tool is incomplete."""
    try:
        parsed = json.loads(data.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        return None, f"chain is not json: {rel}"
    if not isinstance(parsed, dict):
        return None, f"chain is not json: {rel}"
    steps = parsed.get("steps")
    if not isinstance(steps, list):
        return data, None
    for step in steps:
        if not isinstance(step, dict):
            continue
        name = step.get("tool")
        if not isinstance(name, str) or not name:
            continue
        if name not in pins:
            return None, f"incomplete: {rel} missing {name}"
        if isinstance(step.get("tool_sha256"), str) and step["tool_sha256"]:
            step["tool_sha256"] = pins[name]
    newline = b"\n" if data.endswith(b"\n") else b""
    return json.dumps(parsed, indent=2, ensure_ascii=False).encode("utf-8") + newline, None


def _draft_bytes(data: bytes) -> bytes:
    """Imported tools stay unverified. Rewriting the header changes the bytes."""
    lines = []
    for line in data.decode("utf-8", errors="replace").splitlines(keepends=True):
        if line.startswith("# ") and "@tk-verified:" in line:
            lines.append(f"# @tk-verified: none{line[-1:] if line.endswith(chr(10)) else ''}")
        elif line.startswith("# ") and "@tk-provenance:" in line:
            continue
        else:
            lines.append(line)
    return "".join(lines).encode("utf-8")


def _exclusive_write(path: Path, data: bytes, executable: bool) -> str | None:
    """Create only. Never replace an existing name, so a racing writer wins."""
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    mode = 0o755 if executable else 0o644
    try:
        fd = os.open(path, flags, mode)
    except FileExistsError:
        return "exists"
    except OSError as exc:
        return str(exc)
    try:
        os.write(fd, data)
        os.fsync(fd)
    except OSError as exc:
        os.close(fd)
        try:
            os.unlink(path)
        except OSError:
            pass
        return str(exc)
    os.close(fd)
    os.chmod(path, mode)
    return None


def _rollback(created: list[tuple[Path, str]]) -> list[str]:
    """Remove only names this run created and still holds the bytes it wrote."""
    removed = []
    for path, digest in reversed(created):
        current = _read(path)
        if current is None or _sha256(current) != digest:
            continue
        try:
            os.unlink(path)
        except OSError:
            continue
        removed.append(str(path))
    return removed


def _failure(error: str, why: str, removed: list[str]) -> dict:
    return {
        "error": error,
        "why": why,
        "fix": FIX,
        "removed": removed,
    }


def _capability_name(dest: Path, rel: str, kind: str) -> str:
    path = dest / rel
    if kind == "tool":
        from lib.catalog import parse_tool_header

        return str(parse_tool_header(path).get("name") or "")
    if kind == "chain":
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError, UnicodeError):
            return ""
        if isinstance(data, dict):
            return str(data.get("name") or "")
    return ""


def _mark_drafts(dest: Path, files: list[dict], copied: list[str]) -> str:
    """Imported names start blocked. Header provenance was already stripped."""
    from lib.evolver import mark_execution_draft

    copied_set = set(copied)
    for row in files:
        if row["path"] not in copied_set or row["kind"] not in {"tool", "chain"}:
            continue
        name = _capability_name(dest, row["path"], row["kind"])
        if not name:
            return f"imported file has no name: {row['path']}"
        try:
            mark_execution_draft(dest, name)
        except (OSError, ValueError) as exc:
            return f"{row['path']}: {exc}"
    return ""


def _screen(source: Path, files: list[dict], overrides: set[str]) -> tuple[list[dict], dict]:
    """Re-scan the apply set. A content hit or undecodable file is not copied."""
    scan = _secret_scan()
    kept: list[dict] = []
    for row in files:
        rel = str(row.get("path") or "")
        if _skipped(Path(rel)):
            scan["excluded_by_path"].append(rel)
            continue
        data = _read(source / rel)
        if data is None:
            continue
        if not _classify(rel, data, overrides, scan):
            continue
        kept.append(row)
    return kept, scan


def _apply(source: Path, dest: Path, files: list[dict], write: bool, scan: dict | None = None) -> dict:
    report = scan or _secret_scan()
    plan = [row["path"] for row in files]
    if not write or os.environ.get("TK_DRY_RUN", "0") == "1":
        return {"dry_run": True, "plan": plan, "copied": [], "skipped": [], "secret_scan": report}
    for row in files:
        if not _dest_stays(dest, Path(row["path"])):
            return _failure("dest_escape", f"destination path leaves the checkout: {row['path']}", [])
    created: list[tuple[Path, str]] = []
    copied: list[str] = []
    skipped: list[str] = []
    pins = _destination_pins(source, files)
    for row in files:
        rel = Path(row["path"])
        data = _read(source / rel)
        if data is None or _sha256(data) != row["sha256"]:
            return _failure("hash_mismatch", f"source changed: {row['path']}", _rollback(created))
        if row["kind"] == "tool":
            data = _draft_bytes(data)
        elif row["kind"] == "chain":
            data, pin_error = _rewrite_chain(data, pins, row["path"])
            if pin_error or data is None:
                return _failure("incomplete", pin_error or f"incomplete: {row['path']}", _rollback(created))
        digest = _sha256(data)
        target = dest / rel
        existing = _read(target)
        if existing is not None:
            if _sha256(existing) == digest:
                skipped.append(row["path"])
                continue
            return _failure("collision", f"destination differs: {row['path']}", _rollback(created))
        target.parent.mkdir(parents=True, exist_ok=True)
        error = _exclusive_write(target, data, bool(row["executable"]))
        if error == "exists":
            raced = _read(target)
            if raced is not None and _sha256(raced) == digest:
                skipped.append(row["path"])
                continue
            return _failure("collision", f"destination appeared: {row['path']}", _rollback(created))
        if error:
            return _failure("create_failed", error, _rollback(created))
        written = _read(target)
        if written is None or _sha256(written) != digest:
            return _failure("hash_mismatch", f"wrote unexpected bytes: {row['path']}", _rollback(created))
        created.append((target, digest))
        copied.append(row["path"])
    checks = [
        check_item(dest, dest / row["path"])
        for row in files
        if row["kind"] in {"tool", "chain"} and row["path"] in copied
    ]
    bad = next((row for row in checks if not row.get("ok")), None)
    if bad:
        return _failure("check_failed", f"{bad['name']}: {bad['errors']}", _rollback(created))
    from lib.catalog import discover_catalog
    from lib.runner import _chain_pin_mismatch

    catalog = discover_catalog(dest)
    for row in files:
        if row["kind"] != "chain":
            continue
        item = catalog.get(_capability_name(dest, row["path"], "chain"))
        if not isinstance(item, dict):
            return _failure("pin_mismatch", f"chain was not catalogued: {row['path']}", _rollback(created))
        changed = _chain_pin_mismatch(item, catalog)
        if changed is not None:
            index, name = changed
            return _failure("pin_mismatch", f"step {index} {name} bytes changed", _rollback(created))
    marked = _mark_drafts(dest, files, copied)
    if marked:
        return _failure("draft_unrecorded", marked, _rollback(created))
    return {
        "dry_run": False,
        "copied": copied,
        "skipped": skipped,
        "created": [{"path": path.relative_to(dest).as_posix(), "sha256": digest} for path, digest in created],
        "checks": checks,
        "secret_scan": {
            **report,
            "hit_copied": any(item["path"] in copied for item in report["overrides"]),
        },
    }


def _report(root: Path) -> dict:
    return {
        "dry_run": True,
        "copy": [
            {"kind": "tool", "path": str(root / "tools")},
            {"kind": "chain", "path": str(root / "chains")},
            {"kind": "skill", "path": str(root / "skills" / "agent-toolkit")},
        ],
        "credentials": [
            {
                "name": "gh",
                "where": "already in gh" if os.environ.get("GH_TOKEN") or shutil.which("gh") else "gh not on PATH",
                "copied": False,
            }
        ],
        "secret_scan": _secret_scan(),
        "state_copied": False,
    }


def main() -> int:
    """Apply without --manifest still scans the source. That scan is not a reviewed import."""
    action = (arg_str("--action") or "report").strip().lower()
    if action not in {"report", "export", "apply"}:
        return fail("unknown_action", f"action must be report, export, or apply: {action}", FIX, 2)
    root = Path(os.environ.get("TK_ROOT_DIR") or Path(__file__).resolve().parents[2])
    if action == "report":
        return emit(_report(root))
    reason = _reject_user_path("source", arg_str("--source"))
    if reason:
        return fail("missing_flag", reason, FIX, 2)
    source = Path(arg_str("--source"))
    if not source.is_dir():
        return fail("not_a_checkout", "source is not a directory", FIX, 2)
    overrides, refused = _override_paths()
    if refused:
        return fail("refused", refused, FIX)
    if action == "export":
        manifest, error = _manifest(source, overrides)
        if error or manifest is None:
            return fail("refused", error or "scan failed", FIX)
        manifest["dry_run"] = True
        return emit(manifest)
    reason = _reject_user_path("dest", arg_str("--dest"))
    if reason:
        return fail("missing_flag", reason, FIX, 2)
    dest = Path(arg_str("--dest"))
    if not dest.is_dir():
        return fail("not_a_checkout", "dest is not a directory", FIX, 2)
    manifest_raw = arg_str("--manifest")
    # No manifest: scan is allowed and is not a reviewed import.
    manifest, error = _load_manifest(manifest_raw, source) if manifest_raw else _manifest(source, overrides)
    if error or manifest is None:
        return fail("refused", error or "scan failed", FIX)
    if manifest_raw:
        manifest, error = _load_manifest(manifest_raw, source)
        if error or manifest is None:
            return fail("refused", error or "scan failed", FIX)
        kept, scan = _screen(source, list(manifest["files"]), overrides)
    else:
        kept = list(manifest["files"])
        scan = manifest.get("secret_scan") or _secret_scan()
    result = _apply(source, dest, kept, _truthy(arg_str("--apply")), scan)
    return emit(result, 1 if result.get("error") else 0)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as exc:
        raise SystemExit(fail("internal_error", str(exc), FIX))
