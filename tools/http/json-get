#!/usr/bin/env python3
# @tk-name: http.json-get
# @tk-summary: Fetch a JSON document and optionally keep named top-level keys
# @tk-safety: read-only
# @tk-arg: --url     | required | string | http(s) URL that returns JSON
# @tk-arg: --keys    | optional | string | Comma-separated top-level keys to keep, or all (default: all)
# @tk-arg: --timeout | optional | int    | Socket timeout in seconds (default: 10)
# @tk-output: json | Fetched JSON object or array, optionally reduced to --keys
# @tk-example: tk run http.json-get --url https://example.com/data.json --keys all --timeout 10
# @tk-verified: 2026-11-03

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request


def emit(payload, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def filter_keys(data, keys_raw: str):
    if not keys_raw or keys_raw.strip() == "all":
        return data
    keys = [part.strip() for part in keys_raw.split(",") if part.strip()]
    if isinstance(data, dict):
        return {key: data[key] for key in keys if key in data}
    if isinstance(data, list):
        return [
            {key: item[key] for key in keys if isinstance(item, dict) and key in item}
            for item in data
        ]
    return data


def main() -> int:
    url = os.environ.get("TK_ARG_URL", "")
    keys_raw = os.environ.get("TK_ARG_KEYS") or "all"
    timeout_raw = os.environ.get("TK_ARG_TIMEOUT") or "10"
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        timeout = int(timeout_raw) if str(timeout_raw).isdigit() else 10
        return emit(
            {
                "dry_run": True,
                "url": url or "example",
                "keys": keys_raw,
                "timeout": timeout,
            }
        )
    if not url:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_URL is required",
                "fix": "tk run http.json-get --url <https://...>",
            },
            2,
        )
    try:
        timeout = int(timeout_raw)
    except ValueError:
        return emit(
            {
                "error": "invalid_flag",
                "why": f"timeout is not an int: {timeout_raw}",
                "fix": "tk run http.json-get --url <https://...> --timeout 10",
            },
            2,
        )
    if timeout < 1:
        return emit(
            {
                "error": "invalid_flag",
                "why": "timeout must be >= 1",
                "fix": "tk run http.json-get --url <https://...> --timeout 10",
            },
            2,
        )
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        return emit(
            {
                "error": "invalid_url",
                "why": "url must be an absolute http or https URL",
                "fix": "tk run http.json-get --url https://example.com/data.json",
            },
            2,
        )
    request = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "User-Agent": "tk-http-json-get"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = response.read()
    except urllib.error.HTTPError as exc:
        return emit(
            {
                "error": "http_error",
                "why": f"HTTP {exc.code}",
                "fix": "tk run http.json-get --url <https://...>",
            },
            1,
        )
    except urllib.error.URLError as exc:
        return emit(
            {
                "error": "http_error",
                "why": str(exc.reason),
                "fix": "tk run http.json-get --url <https://...>",
            },
            1,
        )
    try:
        data = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        return emit(
            {
                "error": "invalid_json",
                "why": str(exc),
                "fix": "tk run http.json-get --url <https://...json>",
            },
            1,
        )
    return emit(filter_keys(data, keys_raw))


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": "tool_error",
                    "why": str(exc),
                    "fix": "tk run http.json-get --url <https://...>",
                },
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
