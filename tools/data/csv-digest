#!/usr/bin/env python3
# @tk-name: data.csv-digest
# @tk-summary: Distill CSV or TSV schema, row count, empty-value counts, and sample rows
# @tk-safety: read-only
# @tk-arg: --path | required | string | Path to CSV or TSV file
# @tk-arg: --limit | optional | int | Maximum sample rows to return (default: 10)
# @tk-output: json | {path, delimiter, columns, rows, truncated, null_counts, cells_truncated, sample} | cells_truncated counts sample cells cut to 200 chars
# @tk-example: tk run data.csv-digest --path data.csv --limit 10
# @tk-verified: 2026-11-04

from __future__ import annotations

import csv
import json
import os
import sys

_DEFAULT_LIMIT = 10
_MAX_CELL_CHARS = 200
_DELIMITERS = (",", "\t", ";", "|")


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def _limit(raw: str) -> int | None:
    try:
        return int(raw)
    except ValueError:
        return None


def _is_empty(value: str | None) -> bool:
    return value is None or value.strip() == ""


def _cap_cell(value: str) -> tuple[str, int]:
    if len(value) <= _MAX_CELL_CHARS:
        return value, 0
    return value[:_MAX_CELL_CHARS], 1


def _cap_row(row: dict[str, str]) -> tuple[dict[str, str], int]:
    pairs = [(column, _cap_cell(value)) for column, value in row.items()]
    capped = {column: text for column, (text, _cut) in pairs}
    return capped, sum(cut for _column, (_text, cut) in pairs)


def _detect_delimiter(path: str) -> str:
    with open(path, encoding="utf-8", newline="") as handle:
        sample = handle.read(8192)
    if not sample.strip():
        return ","
    try:
        dialect = csv.Sniffer().sniff(sample, delimiters=",\t;|")
        if dialect.delimiter in _DELIMITERS:
            return dialect.delimiter
    except csv.Error:
        pass
    first = sample.splitlines()[0]
    counts = {delimiter: first.count(delimiter) for delimiter in _DELIMITERS}
    best = max(_DELIMITERS, key=lambda delimiter: counts[delimiter])
    if counts[best] == 0:
        return ","
    return best


def digest(path: str, limit: int) -> dict:
    delimiter = _detect_delimiter(path)
    columns: list[str] = []
    null_counts: dict[str, int] = {}
    sample: list[dict] = []
    cells_truncated = 0
    rows = 0
    with open(path, encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle, delimiter=delimiter)
        columns = list(reader.fieldnames or [])
        null_counts = {column: 0 for column in columns}
        for row in reader:
            rows += 1
            kept = {column: row.get(column) for column in columns}
            for column, value in list(kept.items()):
                if _is_empty(value):
                    null_counts[column] += 1
                    kept[column] = "" if value is None else value
            if len(sample) < limit:
                text_row = {
                    column: "" if value is None else value
                    for column, value in kept.items()
                }
                capped, cut = _cap_row(text_row)
                sample.append(capped)
                cells_truncated += cut
    return {
        "path": path,
        "delimiter": delimiter,
        "columns": columns,
        "rows": rows,
        "truncated": rows > limit,
        "null_counts": null_counts,
        "cells_truncated": cells_truncated,
        "sample": sample,
    }


def main() -> int:
    path = os.environ.get("TK_ARG_PATH", "")
    limit_raw = os.environ.get("TK_ARG_LIMIT") or str(_DEFAULT_LIMIT)
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        limit = _limit(limit_raw)
        return emit(
            {
                "dry_run": True,
                "path": path,
                "limit": _DEFAULT_LIMIT if limit is None else limit,
            }
        )
    if not path:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_PATH is required",
                "fix": "tk run data.csv-digest --path <path>",
            },
            2,
        )
    limit = _limit(limit_raw)
    if limit is None or limit < 0:
        return emit(
            {
                "error": "invalid_flag",
                "why": f"limit is not a non-negative int: {limit_raw}",
                "fix": "tk run data.csv-digest --path <path> --limit 10",
            },
            2,
        )
    if not os.path.isfile(path):
        return emit(
            {
                "error": "not_found",
                "why": "path does not exist",
                "fix": "tk run data.csv-digest --path <path>",
            },
            2,
        )
    try:
        return emit(digest(path, limit))
    except UnicodeDecodeError:
        return emit(
            {
                "error": "invalid_file",
                "why": "path is not utf-8 text",
                "fix": "tk run data.csv-digest --path <csv-or-tsv>",
            },
            2,
        )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        sys.exit(
            emit(
                {"error": "internal_error", "why": str(exc), "fix": "tk check"},
                1,
            )
        )
