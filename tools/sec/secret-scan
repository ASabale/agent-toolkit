#!/usr/bin/env python3
# @tk-name: sec.secret-scan
# @tk-summary: Scan a file or directory for leaked secrets and return redacted previews
# @tk-safety: read-only
# @tk-arg: --path | required | string | File or directory path to scan for leaked secrets
# @tk-arg: --limit | optional | int | Maximum findings to return (default: 25)
# @tk-output: json | {path, clean, count, truncated, findings:[{file, line, rule, preview}]}
# @tk-example: tk run sec.secret-scan --path . --limit 20
# @tk-verified: 2026-11-04

import json
import os
import re
import sys

_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", ".code-review-graph"}
_DEFAULT_LIMIT = 25
_RULES = (
    ("aws_access_key", re.compile(r"\b(A3T[A-Z0-9]|AKIA|ASIA)[A-Z0-9]{16}\b")),
    ("github_token", re.compile(r"\b(gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})\b")),
    ("slack_token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("private_key", re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----")),
    (
        "generic_secret",
        re.compile(
            r"(?i)\b(?:api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|password)\s*[:=]\s*['\"]([A-Za-z0-9/+_=.-]{12,})['\"]"
        ),
    ),
)


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def _redact(token: str) -> str:
    if len(token) < 6:
        return "****"
    return token[:4] + "****" + token[-2:]


def _preview(rule: str, match: re.Match) -> str:
    if rule == "private_key":
        return "REDACTED_PRIVATE_KEY"
    secret = match.group(1) if rule == "generic_secret" else match.group(0)
    return match.group(0).replace(secret, _redact(secret), 1)


def _iter_files(root: str):
    if os.path.isfile(root):
        yield root
        return
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = sorted(
            name for name in dirnames if name not in _SKIP_DIRS and not name.startswith(".")
        )
        for name in sorted(filenames):
            yield os.path.join(dirpath, name)


def _rel(root: str, path: str) -> str:
    if os.path.isfile(root):
        return os.path.basename(path)
    return os.path.relpath(path, root).replace(os.sep, "/")


def scan(root: str, limit: int) -> dict:
    findings: list[dict] = []
    for path in _iter_files(root):
        try:
            raw = open(path, "rb").read()
        except OSError:
            continue
        if b"\x00" in raw:
            continue
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue
        rel = _rel(root, path)
        for lineno, line in enumerate(text.splitlines(), start=1):
            claimed: list[tuple[int, int]] = []
            for rule, compiled in _RULES:
                for match in compiled.finditer(line):
                    start, end = match.span()
                    if any(start < prev_end and prev_start < end for prev_start, prev_end in claimed):
                        continue
                    claimed.append((start, end))
                    findings.append(
                        {
                            "file": rel,
                            "line": lineno,
                            "rule": rule,
                            "preview": _preview(rule, match),
                        }
                    )
    kept = findings[:limit]
    return {
        "path": root,
        "clean": len(findings) == 0,
        "count": len(findings),
        "truncated": len(findings) > limit,
        "findings": kept,
    }


def _limit(raw: str) -> int | None:
    try:
        return int(raw)
    except ValueError:
        return None


def main() -> int:
    path = os.environ.get("TK_ARG_PATH", "")
    limit_raw = os.environ.get("TK_ARG_LIMIT") or str(_DEFAULT_LIMIT)
    if os.environ.get("TK_DRY_RUN", "0") == "1":
        limit = _limit(limit_raw)
        return emit(
            {
                "dry_run": True,
                "path": path,
                "limit": _DEFAULT_LIMIT if limit is None else limit,
            }
        )
    if not path:
        return emit(
            {
                "error": "missing_flag",
                "why": "TK_ARG_PATH is required",
                "fix": "tk run sec.secret-scan --path <path>",
            },
            2,
        )
    limit = _limit(limit_raw)
    if limit is None or limit < 0:
        return emit(
            {
                "error": "invalid_flag",
                "why": f"limit is not a non-negative int: {limit_raw}",
                "fix": "tk run sec.secret-scan --path <path> --limit 25",
            },
            2,
        )
    if not os.path.exists(path):
        return emit(
            {
                "error": "not_found",
                "why": "path does not exist",
                "fix": "tk run sec.secret-scan --path <path>",
            },
            2,
        )
    return emit(scan(path, limit))


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        sys.exit(
            emit(
                {"error": "internal_error", "why": str(exc), "fix": "tk check"},
                1,
            )
        )
