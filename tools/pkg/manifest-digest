#!/usr/bin/env python3
# @tk-name: pkg.manifest-digest
# @tk-summary: Distill name, version, scripts, and dependencies from project manifests
# @tk-safety: read-only
# @tk-arg: --path | required | string | Project directory or manifest file path
# @tk-arg: --limit | optional | int | Maximum dependencies to list per category (default: 30)
# @tk-output: json | {path, manifests, name, version, scripts, dependencies, dev_dependencies, truncated}
# @tk-example: tk run pkg.manifest-digest --path . --limit 20
# @tk-verified: 2026-11-04

import json
import os
import re
import sys

FIX = "tk run pkg.manifest-digest --path . --limit 20"
_NAMES = (
    "package.json",
    "pyproject.toml",
    "requirements.txt",
    "Cargo.toml",
    "go.mod",
)
_STRING = re.compile(r"""^\s*([A-Za-z0-9_-]+)\s*=\s*["']([^"']*)["']\s*$""")
_DEP = re.compile(r"""^\s*([A-Za-z0-9_.-]+)\s*=\s*["']([^"']*)["']""")


def emit(payload: dict, code: int = 0) -> int:
    stream = sys.stdout if code == 0 else sys.stderr
    stream.write(json.dumps(payload, separators=(",", ":")) + "\n")
    return code


def fail(error: str, why: str, code: int = 1) -> int:
    return emit({"error": error, "why": why, "fix": FIX}, code)


def _read(path: str) -> str:
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def _dep_name(spec: str) -> str:
    text = spec.strip().strip("\"'")
    if not text or text.startswith("#"):
        return ""
    seps = (">=", "<=", "==", "~=", "!=", ">", "<", "@", "[", ";", " ")
    cut = len(text)
    for sep in seps:
        idx = text.find(sep)
        if idx != -1:
            cut = min(cut, idx)
    return text[:cut].strip()


def _cap(items: list[str], limit: int) -> tuple[list[str], int]:
    unique: list[str] = []
    seen: set[str] = set()
    for item in items:
        if item and item not in seen:
            seen.add(item)
            unique.append(item)
    return unique[:limit], max(0, len(unique) - limit)


def _parse_package(text: str) -> dict:
    data = json.loads(text)
    if not isinstance(data, dict):
        return {}
    scripts = data.get("scripts") if isinstance(data.get("scripts"), dict) else {}
    return {
        "name": str(data.get("name") or ""),
        "version": str(data.get("version") or ""),
        "scripts": {str(key): str(value) for key, value in scripts.items()},
        "dependencies": list((data.get("dependencies") or {}).keys()),
        "dev_dependencies": list((data.get("devDependencies") or {}).keys()),
    }


def _toml_tables(text: str) -> dict[str, list[str]]:
    tables: dict[str, list[str]] = {}
    current = ""
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("[") and stripped.endswith("]"):
            current = stripped.strip("[]").strip().strip('"')
            tables.setdefault(current, [])
            continue
        tables.setdefault(current, []).append(line)
    return tables


def _assign(lines: list[str], key: str) -> str:
    prefix = key + " "
    for line in lines:
        match = _STRING.match(line)
        if match and match.group(1) == key:
            return match.group(2)
        if line.strip().startswith(key) and "=" in line:
            raw = line.split("=", 1)[1].strip().strip("\"'")
            if raw and not raw.startswith("["):
                return raw
    return ""


def _array(lines: list[str], key: str) -> list[str]:
    blob = "\n".join(lines)
    match = re.search(rf"{re.escape(key)}\s*=\s*\[(.*?)\]", blob, re.DOTALL)
    if not match:
        return []
    return [item for item in (_dep_name(part) for part in re.findall(r'"([^"]+)"', match.group(1))) if item]


def _table_keys(lines: list[str]) -> list[str]:
    names: list[str] = []
    for line in lines:
        match = _DEP.match(line)
        if match:
            names.append(match.group(1))
    return names


def _parse_pyproject(text: str) -> dict:
    try:
        import tomllib

        data = tomllib.loads(text)
    except Exception:
        data = None
    if isinstance(data, dict):
        project = data.get("project") if isinstance(data.get("project"), dict) else {}
        tool = data.get("tool") if isinstance(data.get("tool"), dict) else {}
        poetry = tool.get("poetry") if isinstance(tool.get("poetry"), dict) else {}
        name = str(project.get("name") or poetry.get("name") or "")
        version = str(project.get("version") or poetry.get("version") or "")
        scripts = project.get("scripts") if isinstance(project.get("scripts"), dict) else {}
        deps = [_dep_name(str(item)) for item in project.get("dependencies") or []]
        dev: list[str] = []
        optional = project.get("optional-dependencies")
        if isinstance(optional, dict):
            for group in optional.values():
                if isinstance(group, list):
                    dev.extend(_dep_name(str(item)) for item in group)
        groups = data.get("dependency-groups")
        if isinstance(groups, dict):
            for group in groups.values():
                if isinstance(group, list):
                    dev.extend(_dep_name(str(item)) for item in group)
        poetry_deps = poetry.get("dependencies") if isinstance(poetry.get("dependencies"), dict) else {}
        poetry_dev = poetry.get("dev-dependencies") if isinstance(poetry.get("dev-dependencies"), dict) else {}
        deps.extend(key for key in poetry_deps if key != "python")
        dev.extend(poetry_dev.keys())
        return {
            "name": name,
            "version": version,
            "scripts": {str(key): str(value) for key, value in scripts.items()},
            "dependencies": deps,
            "dev_dependencies": dev,
        }
    tables = _toml_tables(text)
    project = tables.get("project", [])
    scripts = tables.get("project.scripts", [])
    return {
        "name": _assign(project, "name"),
        "version": _assign(project, "version"),
        "scripts": {match.group(1): match.group(2) for line in scripts if (match := _STRING.match(line))},
        "dependencies": _array(project, "dependencies"),
        "dev_dependencies": _array(tables.get("dependency-groups.dev", []), "dev")
        + _table_keys(tables.get("project.optional-dependencies.dev", [])),
    }


def _parse_requirements(text: str) -> dict:
    deps: list[str] = []
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped.startswith("-"):
            continue
        name = _dep_name(stripped.split("#", 1)[0])
        if name:
            deps.append(name)
    return {"dependencies": deps}


def _parse_cargo(text: str) -> dict:
    try:
        import tomllib

        data = tomllib.loads(text)
    except Exception:
        data = None
    if isinstance(data, dict):
        package = data.get("package") if isinstance(data.get("package"), dict) else {}
        deps = data.get("dependencies") if isinstance(data.get("dependencies"), dict) else {}
        dev = data.get("dev-dependencies") if isinstance(data.get("dev-dependencies"), dict) else {}
        return {
            "name": str(package.get("name") or ""),
            "version": str(package.get("version") or ""),
            "dependencies": list(deps.keys()),
            "dev_dependencies": list(dev.keys()),
        }
    tables = _toml_tables(text)
    package = tables.get("package", [])
    return {
        "name": _assign(package, "name"),
        "version": _assign(package, "version"),
        "dependencies": _table_keys(tables.get("dependencies", [])),
        "dev_dependencies": _table_keys(tables.get("dev-dependencies", [])),
    }


def _parse_gomod(text: str) -> dict:
    name = ""
    version = ""
    deps: list[str] = []
    in_require = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("module "):
            name = stripped.split(None, 1)[1].strip()
            continue
        if stripped.startswith("go ") and not version:
            version = stripped.split(None, 1)[1].strip()
        if stripped.startswith("require ("):
            in_require = True
            continue
        if in_require and stripped == ")":
            in_require = False
            continue
        if stripped.startswith("require ") and not in_require:
            parts = stripped.split()
            if len(parts) >= 2:
                deps.append(parts[1])
            continue
        if in_require and stripped and not stripped.startswith("//"):
            deps.append(stripped.split()[0])
    return {"name": name, "version": version, "dependencies": deps}


def _targets(path: str) -> list[str]:
    if os.path.isdir(path):
        return [os.path.join(path, name) for name in _NAMES if os.path.isfile(os.path.join(path, name))]
    base = os.path.basename(path)
    if os.path.isfile(path) and base in _NAMES:
        return [path]
    return []


def digest(path: str, limit: int) -> dict:
    manifests: list[str] = []
    name = ""
    version = ""
    scripts: dict[str, str] = {}
    dependencies: list[str] = []
    dev_dependencies: list[str] = []
    parsers = {
        "package.json": _parse_package,
        "pyproject.toml": _parse_pyproject,
        "requirements.txt": _parse_requirements,
        "Cargo.toml": _parse_cargo,
        "go.mod": _parse_gomod,
    }
    for target in _targets(path):
        base = os.path.basename(target)
        parsed = parsers[base](_read(target))
        manifests.append(base)
        if not name and parsed.get("name"):
            name = parsed["name"]
        if not version and parsed.get("version"):
            version = parsed["version"]
        scripts.update(parsed.get("scripts") or {})
        dependencies.extend(parsed.get("dependencies") or [])
        dev_dependencies.extend(parsed.get("dev_dependencies") or [])
    dependencies, cut_deps = _cap(dependencies, limit)
    dev_dependencies, cut_dev = _cap(dev_dependencies, limit)
    return {
        "path": path,
        "manifests": manifests,
        "name": name,
        "version": version,
        "scripts": scripts,
        "dependencies": dependencies,
        "dev_dependencies": dev_dependencies,
        "truncated": cut_deps + cut_dev,
    }


def main() -> int:
    path = os.environ.get("TK_ARG_PATH", "")
    raw_limit = os.environ.get("TK_ARG_LIMIT") or "30"
    dry = os.environ.get("TK_DRY_RUN", "0") == "1"
    try:
        limit = int(raw_limit)
    except ValueError:
        if dry:
            limit = 30
        else:
            return fail("invalid_flag", f"limit is not an int: {raw_limit}", 2)
    if dry:
        return emit({"dry_run": True, "path": path, "limit": limit})
    if limit < 0:
        return fail("invalid_flag", "limit must be >= 0", 2)
    if not path or not os.path.exists(path):
        return fail("not_found", f"path not found: {path}", 1)
    raw_path = path
    if not _targets(raw_path):
        return emit(
            {
                "error": "no_manifest_found",
                "why": f"no supported manifest found in {raw_path}",
                "fix": FIX,
            },
            1,
        )
    try:
        return emit(digest(path, limit))
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        return fail("manifest_error", str(exc), 1)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        sys.stderr.write(
            json.dumps(
                {"error": "tool_error", "why": str(exc), "fix": FIX},
                separators=(",", ":"),
            )
            + "\n"
        )
        raise SystemExit(1)
