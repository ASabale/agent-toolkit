{
  "kind": "chain",
  "name": "git.repo-health",
  "summary": "Branch drift and dirty-file digest for one git working tree",
  "safety": "read-only",
  "args": [
    {
      "flag": "--repo",
      "env_var": "TK_ARG_REPO",
      "required": true,
      "type": "string",
      "description": "Path to the git working tree",
      "default": null
    }
  ],
  "steps": [
    {
      "tool": "git.branch-digest",
      "args": {
        "repo": "$input.repo"
      }
    },
    {
      "tool": "json.pick",
      "args": {
        "keys": "branch,ahead,behind,dirty,detached,upstream"
      }
    }
  ],
  "output": "json | {branch, ahead, behind, dirty, detached, upstream}",
  "example": "tk run git.repo-health --repo .",
  "verified": "2026-11-03"
}
