{
  "kind": "chain",
  "name": "sql.inspect-db",
  "summary": "SQLite table list with columns and row counts",
  "safety": "read-only",
  "args": [
    {
      "flag": "--db",
      "env_var": "TK_ARG_DB",
      "required": true,
      "type": "string",
      "description": "Path to the SQLite database file",
      "default": null
    }
  ],
  "steps": [
    {
      "tool": "sql.schema",
      "args": {
        "db": "$input.db"
      }
    },
    {
      "tool": "json.pick",
      "args": {
        "keys": "db,table_count,tables"
      }
    }
  ],
  "output": "json | {db, table_count, tables}",
  "example": "tk run sql.inspect-db --db example.db",
  "verified": "2026-11-03"
}
