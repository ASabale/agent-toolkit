{
  "kind": "chain",
  "name": "code.module-surface",
  "summary": "Class and function surface of a file or directory",
  "safety": "read-only",
  "args": [
    {
      "flag": "--path",
      "env_var": "TK_ARG_PATH",
      "required": true,
      "type": "string",
      "description": "File or directory path to extract symbols from",
      "default": null
    }
  ],
  "steps": [
    {
      "tool": "code.symbols",
      "args": {
        "path": "$input.path"
      }
    },
    {
      "tool": "json.pick",
      "args": {
        "keys": "path,count,truncated,symbols"
      }
    }
  ],
  "output": "json | {path, count, truncated, symbols}",
  "example": "tk run code.module-surface --path lib",
  "verified": "2026-11-04"
}
