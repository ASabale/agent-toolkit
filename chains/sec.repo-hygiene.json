{
  "kind": "chain",
  "name": "sec.repo-hygiene",
  "summary": "Redacted secret-scan digest for a file or directory",
  "safety": "read-only",
  "args": [
    {
      "flag": "--path",
      "env_var": "TK_ARG_PATH",
      "required": true,
      "type": "string",
      "description": "File or directory path to scan for leaked secrets",
      "default": null
    },
    {
      "flag": "--limit",
      "required": false,
      "type": "int",
      "description": "Maximum findings to return (default: 25)",
      "default": "25"
    }
  ],
  "steps": [
    {
      "tool": "sec.secret-scan",
      "args": {
        "path": "$input.path",
        "limit": "$input.limit"
      }
    },
    {
      "tool": "json.pick",
      "args": {
        "keys": "clean,count,findings"
      }
    }
  ],
  "output": "json | {clean, count, findings}",
  "example": "tk run sec.repo-hygiene --path .",
  "verified": "2026-11-04"
}
