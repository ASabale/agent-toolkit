{
  "kind": "chain",
  "name": "gh.pr-overview",
  "summary": "Pull request title, stats, and per-file hunks",
  "safety": "read-only",
  "args": [
    {
      "flag": "--repo",
      "env_var": "TK_ARG_REPO",
      "required": true,
      "type": "string",
      "description": "Repository in owner/name format",
      "default": null
    },
    {
      "flag": "--pr",
      "env_var": "TK_ARG_PR",
      "required": true,
      "type": "int",
      "description": "Pull request number",
      "default": null
    }
  ],
  "steps": [
    {
      "tool": "gh.pr-diff-digest",
      "args": {
        "repo": "$input.repo",
        "pr": "$input.pr"
      }
    },
    {
      "tool": "json.pick",
      "args": {
        "keys": "repo,pr,title,state,files_changed,additions,deletions,files"
      }
    }
  ],
  "output": "json | {repo, pr, title, state, files_changed, additions, deletions, files}",
  "example": "tk run gh.pr-overview --repo cli/cli --pr 1",
  "verified": "2026-11-04"
}
