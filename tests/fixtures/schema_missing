#!/bin/bash
# @tk-name: fixture.schema-missing
# @tk-summary: Dry-run object omits a declared schema key
# @tk-safety: read-only
# @tk-output: json | object
# @tk-example: tk run fixture.schema-missing
# @tk-verified: none
# @tk-schema: {ok, count}
if [[ "${TK_DRY_RUN:-0}" == "1" ]]; then
  printf '%s\n' '{"dry_run":true}'
  exit 0
fi
printf '%s\n' '{"ok":true}'
